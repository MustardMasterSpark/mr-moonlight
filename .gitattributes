*.7z     filter=lfs diff=lfs merge=lfs -text
*.rar    filter=lfs diff=lfs merge=lfs -text
*.gz     filter=lfs diff=lfs merge=lfs -text

# NOTE: *.unitypackage is NOT listed here. It is ignored in .gitignore instead.
# Asset Store packages are re-downloadable; committing them doubles the LFS
# footprint for no benefit. Some templates LFS-track it — don't.


# =============================================================================
#  12. HEIGHTMAP EXPORTS
#  Small (~2 MB) partial backups of terrain shape while TerrainData is excluded.
# =============================================================================
*.raw    filter=lfs diff=lfs merge=lfs -text
*.r16    filter=lfs diff=lfs merge=lfs -text


# =============================================================================
#  13. DIFF SUPPRESSION
#  Keeps generated files out of diffs and out of GitHub language statistics.
# =============================================================================
Packages/packages-lock.json linguist-generated=true
Assets/ThirdParty/**        linguist-vendored=true
# =============================================================================
#  MR. MOONLIGHT — .gitattributes
#  Place at the project root, next to Assets/ Packages/ ProjectSettings/
#
#  ORDER MATTERS. Git applies the LAST pattern that matches a file.
#  The binary .asset exceptions MUST stay below the generic .asset rule.
#
#  CORE RULE: a file is either LFS-binary OR YAML-merged. NEVER both.
#  Combining `filter=lfs` with `merge=unityyamlmerge` on the same file is the
#  documented cause of corrupted TerrainData and LightingData assets.
# =============================================================================


# =============================================================================
#  1. DEFAULT
# =============================================================================
* text=auto


# =============================================================================
#  2. TEXT FILES
# =============================================================================
*.cs        text diff=csharp
*.shader    text
*.shadergraph text
*.hlsl      text
*.cginc     text
*.compute   text
*.asmdef    text
*.asmref    text
*.json      text
*.md        text
*.txt       text
*.uxml      text
*.uss       text
*.yml       text
*.yaml      text
*.xml       text
*.csv       text
*.gitattributes text
.gitignore  text


# =============================================================================
#  3. UNITY YAML — SMART MERGE
#  Unity's own SmartMerge documentation scopes this tool to .unity and .prefab.
#  The wider lists circulating online are the source of the corruption reports.
#  This list stays deliberately conservative.
# =============================================================================
*.unity              merge=unityyamlmerge eol=lf
*.prefab             merge=unityyamlmerge eol=lf


# =============================================================================
#  4. UNITY YAML — TEXT, NO MERGE DRIVER
#  Normalised to LF and diffable, but resolved by hand on conflict. For a solo
#  developer, conflicts here are rare and a manual resolution is safer than a
#  merge driver that can silently mangle the file.
# =============================================================================
*.mat                eol=lf
*.anim               eol=lf
*.controller         eol=lf
*.overrideController eol=lf
*.physicMaterial     eol=lf
*.physicsMaterial2D  eol=lf
*.mask               eol=lf
*.playable           eol=lf
*.signal             eol=lf
*.terrainlayer       eol=lf
*.renderTexture      eol=lf
*.spriteatlas        eol=lf
*.guiskin            eol=lf
*.flare              eol=lf
*.fontsettings       eol=lf
*.mixer              eol=lf
*.lighting           eol=lf
*.inputactions       eol=lf
*.asset              eol=lf
*.meta               eol=lf


# =============================================================================
#  5. BINARY .asset EXCEPTIONS  <<< MUST STAY BELOW SECTION 4 >>>
#  These file types keep binary payloads inside a .asset wrapper even under
#  Force Text serialization. Treating them as text corrupts them.
#  LFS only. No merge driver. No eol.
# =============================================================================
*_[Tt]errain.asset       filter=lfs diff=lfs merge=lfs -text
*[Tt]errain[Dd]ata.asset filter=lfs diff=lfs merge=lfs -text
LightingData.asset       filter=lfs diff=lfs merge=lfs -text
NavMesh.asset            filter=lfs diff=lfs merge=lfs -text
*[Nn]av[Mm]esh[Dd]ata.asset filter=lfs diff=lfs merge=lfs -text

# NOTE: the terrain rules above are currently INERT — .gitignore excludes
# terrain assets during the sculpting phase. They are staged here so that
# deleting the .gitignore block is the only step needed to start tracking
# terrain correctly. Do not remove them.


# =============================================================================
#  6. LFS — 3D
# =============================================================================
*.fbx    filter=lfs diff=lfs merge=lfs -text
*.FBX    filter=lfs diff=lfs merge=lfs -text
*.obj    filter=lfs diff=lfs merge=lfs -text
*.blend  filter=lfs diff=lfs merge=lfs -text

# =============================================================================
sysinfo.txt
mono_crash.*
crashlytics-build.properties


# =============================================================================
#  BUILDS AND PACKAGES
# =============================================================================
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta

# NOTE: .unitypackage is ignored deliberately. Asset Store packages are
# re-downloadable from My Assets; committing them doubles your LFS footprint
# for zero benefit. This overrides the LFS rule some templates include.



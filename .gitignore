# =============================================================================
#  MR. MOONLIGHT — .gitignore
#  Place at the project root, next to Assets/ Packages/ ProjectSettings/
#
#  Base: https://github.com/github/gitignore/blob/main/Unity.gitignore
#  Plus: OS/editor globals, agent-workflow entries, terrain exclusion block.
# =============================================================================


# =============================================================================
#  UNITY GENERATED
# =============================================================================
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# Blender backup files — Unity imports .blend natively, .blend1 is just a backup
*.blend1
*.blend1.meta

# MemoryCaptures get very large and can contain sensitive data
/[Mm]emoryCaptures/

# Recordings get very large
/[Rr]ecordings/


# =============================================================================
#  ASSET STORE / IDE TOOLING
# =============================================================================
# Uncomment if you import the Asset Store Tools plugin and don't want it tracked
# /[Aa]ssets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# JetBrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Editor config directories
.vscode/
.idea/



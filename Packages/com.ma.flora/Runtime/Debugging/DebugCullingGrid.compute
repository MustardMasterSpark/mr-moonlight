//--------------------------------------------------------------------------------------------------
// Definitions
//--------------------------------------------------------------------------------------------------
#pragma kernel BuildBlockLines
#pragma kernel BuildCellLines
#pragma kernel BuildChunkLines
#pragma kernel BuildDrawArgs

#pragma only_renderers d3d11 playstation xboxone xboxseries vulkan metal switch switch2 webgpu
#pragma use_dxc metal vulkan
// #pragma enable_d3d11_debug_symbols

#define THREADING_BLOCK_SIZE 64 // Max instances per chunk

//--------------------------------------------------------------------------------------------------
// Includes
//--------------------------------------------------------------------------------------------------

#include "Packages/com.ma.flora/Runtime/Graphics/ComputeUtility.hlsl"
#include "Packages/com.ma.flora/Runtime/Culling/CullingGrid.hlsl"
#include "Packages/com.ma.flora/Runtime/Debugging/DebugCullingGrid.cs.hlsl"
#include "Packages/com.ma.flora/ShaderLibrary/Frustum.hlsl"

//--------------------------------------------------------------------------------------------------
// Constants
//--------------------------------------------------------------------------------------------------

#define _CameraPosition    _CameraPositionAndDist.xyz
#define _MaxDistance       _CameraPositionAndDist.w
#define _VisualizationMode uint(_CullingSettings.x)
#define _MaxAlpha          _CullingSettings.w

static const uint kVisualizationMode_Level   = 0;
static const uint kVisualizationMode_Heatmap = 1;

static const uint kBlockLevelShift   = 3; // 8 cells per block dimension

static const uint kCellsPerBlockDim  = 8;
static const uint kCellsPerBlock     = kCellsPerBlockDim * kCellsPerBlockDim * kCellsPerBlockDim;
static const uint kCellsPerBlockWord = kCellsPerBlock >> 6; // 64 bits per word

static const uint kHeatmapCount = 7;
static const uint kHeatmapMax   = kHeatmapCount - 1;
static const float3 kHeatmapColors[kHeatmapCount] = {
    float3(158.0 / 255.0, 228.0 / 255.0, 251.0 / 255.0), // #9EE4FB
    float3(056.0 / 255.0, 243.0 / 255.0, 176.0 / 255.0), // #38F3B0
    float3(168.0 / 255.0, 238.0 / 255.0, 046.0 / 255.0), // #A8EE2E
    float3(255.0 / 255.0, 214.0 / 255.0, 000.0 / 255.0), // #FFD600
    float3(253.0 / 255.0, 152.0 / 255.0, 000.0 / 255.0), // #FD9800
    float3(255.0 / 255.0, 067.0 / 255.0, 051.0 / 255.0), // #FF4333
    float3(132.0 / 255.0, 010.0 / 255.0, 054.0 / 255.0)  // #840A36
};


static const uint kCellHotInstanceCount  = 16 * 1024;
static const uint kBlockHotInstanceCount = kCellHotInstanceCount * kCellsPerBlock;

static const uint kLevelCount = 16;
static const uint kLevelMax   = kLevelCount - 1;
static const float3 kLevelColors[kLevelCount] = {
    float3(1.00, 0.23, 0.19), // 0:  #FF3B30 (red)
    float3(1.00, 0.42, 0.00), // 1:  #FF6A00 (orange)
    float3(1.00, 0.72, 0.00), // 2:  #FFB700 (amber)
    float3(0.64, 0.90, 0.21), // 3:  #A3E635 (lime)
    float3(0.13, 0.77, 0.37), // 4:  #22C55E (green)
    float3(0.06, 0.73, 0.62), // 5:  #10B981 (emerald/teal)
    float3(0.02, 0.72, 0.83), // 6:  #06B6D4 (cyan)
    float3(0.23, 0.51, 0.96), // 7:  #3B82F6 (blue)
    float3(0.15, 0.39, 0.92), // 8:  #2563EB (royal blue)
    float3(0.49, 0.23, 0.93), // 9:  #7C3AED (violet)
    float3(0.66, 0.33, 0.97), // 10: #A855F7 (purple)
    float3(0.93, 0.28, 0.60), // 11: #EC4899 (pink)
    float3(0.96, 0.25, 0.37), // 12: #F43F5E (rose)
    float3(0.97, 0.45, 0.09), // 13: #F97316 (deep orange)
    float3(0.52, 0.80, 0.09), // 14: #84CC16 (yellow-green)
    float3(0.08, 0.72, 0.65), // 15: #14B8A6 (teal)
};

//--------------------------------------------------------------------------------------------------
// Uniforms
//--------------------------------------------------------------------------------------------------

RWStructuredBuffer<DebugLineVertex> _LineVertices;
RWStructuredBuffer<uint>            _LineVertexCounter;

//--------------------------------------------------------------------------------------------------
// Common
//--------------------------------------------------------------------------------------------------

DebugLineVertex MakeDebugLineVertex(float3 position, float weight, float3 color, float alpha)
{
    DebugLineVertex vertex;
    vertex.position = position;
    vertex.weight = weight;
    vertex.color = float4(color, alpha);
    return vertex;
}

uint CellIndexToBlockIndex(uint cellIndex)
{
    return cellIndex >> kBlockLevelShift;
}

uint SizeToLevel(float size)
{
    return uint(floor(log2(size + 1.0)) - 1u);
}

bool CullBounds(float3 center, float3 extent)
{
    if (_MaxDistance <= 0) return false;
    float3 min = center - extent;
    float3 max = center + extent;
    float3 closest = clamp(_CameraPosition.xyz, min, max);
    float3 dist = closest - _CameraPosition.xyz;
    return dot(dist, dist) > (_MaxDistance * _MaxDistance);
}

float CalculateAlphaByDistance(float3 center)
{
    if (_MaxDistance <= 0) return 1.0;
    float d = distance(center, _CameraPosition.xyz);
    return saturate(1.0 - d / _MaxDistance);
}

float NormalizeLog(uint x, uint max)
{
    return (x == 0) ? 0.0 : saturate(log2(x + 1.0) / log2(max + 1.0));
}

float3 HeatmapColor(float t)
{
    float x = saturate(t) * kHeatmapMax;
    uint a = (uint)floor(x);
    uint b = min(a + 1, kHeatmapMax);
    return lerp(kHeatmapColors[a], kHeatmapColors[b], frac(x));
}

float3 LevelColor(uint level)
{
    uint bin = clamp(level, 0u, kLevelMax);
    return kLevelColors[bin];
}

static const uint kBoxIndices[24] = {
    // bottom rectangle
    0,1, 1,3, 3,2, 2,0,
    // top rectangle
    4,5, 5,7, 7,6, 6,4,
    // verticals
    0,4, 1,5, 2,6, 3,7
};

void EmitBox(float3 center, float3 extent, float weight, float3 color)
{
    // 12 edges, 24 vertices

    float3 vertices[8];
    vertices[0] = center + float3(-extent.x, -extent.y, -extent.z);
    vertices[1] = center + float3( extent.x, -extent.y, -extent.z);
    vertices[2] = center + float3(-extent.x, -extent.y,  extent.z);
    vertices[3] = center + float3( extent.x, -extent.y,  extent.z);
    vertices[4] = center + float3(-extent.x,  extent.y, -extent.z);
    vertices[5] = center + float3( extent.x,  extent.y, -extent.z);
    vertices[6] = center + float3(-extent.x,  extent.y,  extent.z);
    vertices[7] = center + float3( extent.x,  extent.y,  extent.z);

    uint baseIndex;
    InterlockedAdd(_LineVertexCounter[0], 24, baseIndex);

    float alpha = CalculateAlphaByDistance(center) * _MaxAlpha;

    UNITY_UNROLL
    for (uint i = 0; i < 24; i += 2)
    {
        _LineVertices[baseIndex + i + 0] = MakeDebugLineVertex(vertices[kBoxIndices[i + 0]], weight, color, alpha);
        _LineVertices[baseIndex + i + 1] = MakeDebugLineVertex(vertices[kBoxIndices[i + 1]], weight, color, alpha);
    }
}

//--------------------------------------------------------------------------------------------------
// Blocks
//--------------------------------------------------------------------------------------------------

uint _BlockCount;
StructuredBuffer<uint> _BlockIndices;
StructuredBuffer<uint> _CellInstanceCounts;

[numthreads(THREADING_BLOCK_SIZE, 1, 1)]
void BuildBlockLines(Threading::Group group)
{
    uint dispatchIndex = UnwrapLinearDispatchThreadID(group);
    if (dispatchIndex >= _BlockCount)
        return;

    uint blockIndex = _BlockIndices[dispatchIndex];
    BlockData blockData = _BlockData[blockIndex];

    float size = blockData.cellSize * kCellsPerBlockDim;
    float3 min = blockData.position;
    float3 center = min + float3(size, size, size) * 0.5;
    float3 extent = float3(size, size, size) * 0.5;

    if (CullFrustumPlanes(center, extent, _FrustumPlanes, 6)) return;
    if (CullBounds(center, extent)) return;

    float3 color;
    float weight;
    if (_VisualizationMode == kVisualizationMode_Heatmap)
    {
        uint cellStartIndex = blockIndex * kCellsPerBlock;
        uint instanceCount = 0;

        for (uint indexInBlock = 0; indexInBlock < kCellsPerBlock; ++indexInBlock)
            instanceCount += _CellInstanceCounts[cellStartIndex + indexInBlock];

        weight = NormalizeLog(instanceCount, kBlockHotInstanceCount);
        color = HeatmapColor(weight);
    }
    else
    {
        uint level = SizeToLevel(size);
        weight = float(level) / float(kLevelMax);
        color = LevelColor(level);
    }

    EmitBox(center, extent, weight, color);
}

//--------------------------------------------------------------------------------------------------
// Cells
//--------------------------------------------------------------------------------------------------

uint _CellCount;
StructuredBuffer<uint> _CellIndices;

[numthreads(THREADING_BLOCK_SIZE, 1, 1)]
void BuildCellLines(Threading::Group group)
{
    uint dispatchIndex = UnwrapLinearDispatchThreadID(group);
    if (dispatchIndex >= _CellCount)
        return;

    uint cellIndex = _CellIndices[dispatchIndex];
    CellData cellData = LoadCellData(cellIndex);

    float size = cellData.blockData.cellSize;
    float3 min = cellData.blockData.position + float3(cellData.localCellCoord) * size;
    float3 center = min + float3(size, size, size) * 0.5;
    float3 extent = float3(size, size, size) * 0.5;

    if (CullFrustumPlanes(center, extent, _FrustumPlanes, 6)) return;
    if (CullBounds(center, extent)) return;

    float3 color;
    float weight;
    if (_VisualizationMode == kVisualizationMode_Heatmap)
    {
        uint instanceCount = _CellInstanceCounts[cellIndex];
        weight = NormalizeLog(instanceCount, kCellHotInstanceCount);
        color = HeatmapColor(weight);
    }
    else
    {
        uint level = SizeToLevel(size);
        weight = float(level) / float(kLevelMax);
        color = LevelColor(level);
    }

    EmitBox(center, extent, weight, color);
}

//--------------------------------------------------------------------------------------------------
// Chunks
//--------------------------------------------------------------------------------------------------

uint _ChunkCount;
StructuredBuffer<uint> _ChunkIndices;

[numthreads(THREADING_BLOCK_SIZE, 1, 1)]
void BuildChunkLines(Threading::Group group)
{
    uint dispatchIndex = UnwrapLinearDispatchThreadID(group);
    if (dispatchIndex >= _ChunkCount)
        return;

    uint chunkIndex = _ChunkIndices[dispatchIndex];
    uint cellIndex = _CullingChunkCells[chunkIndex];
    CellData cellData = LoadCellData(cellIndex);

    float cellSize = cellData.blockData.cellSize;
    float3 cellMin = cellData.blockData.position + float3(cellData.localCellCoord) * cellSize - (cellSize * 0.5).xxx;

    CullingChunkAttributes attributes = LoadCullingChunkAttributes(chunkIndex, cellSize * 2.0);
    float3 localCenter = (attributes.boundsMax + attributes.boundsMin) * 0.5;
    float3 localExtent = (attributes.boundsMax - attributes.boundsMin) * 0.5;
    float3 center = cellMin + localCenter;
    float3 extent = localExtent;

    if (CullFrustumPlanes(center, extent, _FrustumPlanes, 6)) return;
    if (CullBounds(center, extent)) return;

    float3 color;
    float weight;
    if (_VisualizationMode == kVisualizationMode_Heatmap)
    {
        CullingChunkBatch chunk = LoadCullingChunkBatch(chunkIndex);
        uint instanceCount = chunk.instanceCount;
        weight = NormalizeLog(instanceCount, THREADING_BLOCK_SIZE);
        color = HeatmapColor(weight);
    }
    else
    {
        float radius = length(extent);
        uint level = SizeToLevel(radius * 2.0);
        weight = float(level) / float(kLevelMax);
        color = LevelColor(level);
    }

    EmitBox(center, extent, weight, color);
}

//--------------------------------------------------------------------------------------------------
// Draw Args
//--------------------------------------------------------------------------------------------------

RWBuffer<uint> _LineDrawArgs;

[numthreads(1, 1, 1)]
void BuildDrawArgs(Threading::Group group)
{
    // vertexCount, instanceCount, startVertex, startInstance
    _LineDrawArgs[0] = _LineVertexCounter[0];
    _LineDrawArgs[1] = 1;
    _LineDrawArgs[2] = 0;
    _LineDrawArgs[3] = 0;
}

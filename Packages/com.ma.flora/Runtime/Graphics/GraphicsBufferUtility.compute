//--------------------------------------------------------------------------------------------------
// Definitions
//--------------------------------------------------------------------------------------------------

#pragma kernel MemsetCS
#pragma kernel MemcpyCS
#pragma kernel ScatterCS

#pragma only_renderers d3d11 playstation xboxone xboxseries vulkan metal switch switch2 webgpu
#pragma use_dxc metal vulkan
// #pragma enable_d3d11_debug_symbols

#pragma multi_compile_local TYPE_RAW_UINT TYPE_RAW_UINT4_ALIGNED TYPE_STRUCTURED_UINT1 TYPE_STRUCTURED_UINT2 TYPE_STRUCTURED_UINT4 TYPE_STRUCTURED_UINT8

#if defined(TYPE_STRUCTURED_UINT1) || defined(TYPE_STRUCTURED_UINT2) || defined(TYPE_STRUCTURED_UINT4) || defined(TYPE_STRUCTURED_UINT8)
#define TYPE_STRUCTURED
#elif defined(TYPE_RAW_UINT) || defined(TYPE_RAW_UINT4_ALIGNED)
#define TYPE_RAW
#endif

#define THREADING_BLOCK_SIZE 64

//--------------------------------------------------------------------------------------------------
// Includes
//--------------------------------------------------------------------------------------------------

#include "Packages/com.ma.flora/Runtime/Graphics/ComputeUtility.hlsl"

//--------------------------------------------------------------------------------------------------
// Types
//--------------------------------------------------------------------------------------------------

struct uint8
{
    uint4 v0;
    uint4 v1;
};

uint8 NewUInt8(uint4 v0, uint4 v1)
{
    uint8 result;
    result.v0 = v0;
    result.v1 = v1;
    return result;
}

#if defined(TYPE_STRUCTURED_UINT1)
    #define STRUCTURED_BUFFER_ACCESS(BufferName, Index) BufferName##1x[(Index)]
    #define STRUCTURED_VALUE _Value
#elif defined(TYPE_STRUCTURED_UINT2)
    #define STRUCTURED_BUFFER_ACCESS(BufferName, Index) BufferName##2x[(Index)]
    #define STRUCTURED_VALUE uint2(_Value,_Value)
#elif defined(TYPE_STRUCTURED_UINT4)
    #define STRUCTURED_BUFFER_ACCESS(BufferName, Index) BufferName##4x[(Index)]
    #define STRUCTURED_VALUE uint4(_Value,_Value,_Value,_Value)
#elif defined(TYPE_STRUCTURED_UINT8)
    #define STRUCTURED_BUFFER_ACCESS(BufferName, Index) BufferName##8x[(Index)]
    #define STRUCTURED_VALUE NewUInt8(uint4(_Value,_Value,_Value,_Value), uint4(_Value,_Value,_Value,_Value))
#endif

//--------------------------------------------------------------------------------------------------
// Uniforms
//--------------------------------------------------------------------------------------------------

uint _Size;         // Size of the operation
uint _Value;        // Value to be set in the destination buffer
uint _SrcOffset;    // Offset into the source buffer where the operation will start
uint _DstOffset;    // Offset into the destination buffer where the operation will start
uint _ScatterCount; // Number of scatter operations to perform

#if defined(TYPE_STRUCTURED)
StructuredBuffer<uint>    _SrcStructuredBuffer1x;
StructuredBuffer<uint2>   _SrcStructuredBuffer2x;
StructuredBuffer<uint4>   _SrcStructuredBuffer4x;
StructuredBuffer<uint8>   _SrcStructuredBuffer8x;

RWStructuredBuffer<uint>  _DstStructuredBuffer1x;
RWStructuredBuffer<uint2> _DstStructuredBuffer2x;
RWStructuredBuffer<uint4> _DstStructuredBuffer4x;
RWStructuredBuffer<uint8> _DstStructuredBuffer8x;

StructuredBuffer<uint>    _ScatterStructuredBuffer;
StructuredBuffer<uint>    _UploadStructuredBuffer1x;
StructuredBuffer<uint2>   _UploadStructuredBuffer2x;
StructuredBuffer<uint4>   _UploadStructuredBuffer4x;
StructuredBuffer<uint8>   _UploadStructuredBuffer8x;
#elif defined(TYPE_RAW)
ByteAddressBuffer         _SrcByteBuffer;
RWByteAddressBuffer       _DstByteBuffer;

ByteAddressBuffer         _ScatterByteBuffer;
ByteAddressBuffer         _UploadByteBuffer;
#endif

//--------------------------------------------------------------------------------------------------
// Memset
//--------------------------------------------------------------------------------------------------

[numthreads(THREADING_BLOCK_SIZE, 1, 1)]
void MemsetCS(Threading::Group group)
{
    uint dispatchID = UnwrapLinearDispatchThreadID(group);
#if defined(TYPE_STRUCTURED)
    if (dispatchID < _Size)
    {
		STRUCTURED_BUFFER_ACCESS(_DstStructuredBuffer, _DstOffset + dispatchID) = STRUCTURED_VALUE;
    }
#elif defined(TYPE_RAW)
    uint dstIndex = _DstOffset + dispatchID * 4u;

    if (dispatchID * 4u + 3u < _Size)
    {
        _DstByteBuffer.Store4(dstIndex * 4u, uint4(_Value, _Value, _Value, _Value));
    }
    else if (dispatchID * 4u + 2u < _Size)
    {
        _DstByteBuffer.Store3(dstIndex * 4u, uint3(_Value, _Value, _Value));
    }
    else if (dispatchID * 4u + 1u < _Size)
    {
        _DstByteBuffer.Store2(dstIndex * 4u, uint2(_Value, _Value));
    }
    else if (dispatchID * 4u < _Size)
    {
        _DstByteBuffer.Store(dstIndex * 4u, _Value);
    }
#endif
}

//--------------------------------------------------------------------------------------------------
// Memcpy
//--------------------------------------------------------------------------------------------------

[numthreads(THREADING_BLOCK_SIZE, 1, 1)]
void MemcpyCS(Threading::Group group)
{
    uint dispatchID = UnwrapLinearDispatchThreadID(group);
#if defined(TYPE_STRUCTURED)
    if (dispatchID < _Size)
    {
		STRUCTURED_BUFFER_ACCESS(_DstStructuredBuffer, _DstOffset + dispatchID) = STRUCTURED_BUFFER_ACCESS(_SrcStructuredBuffer, _SrcOffset + dispatchID);
    }
#elif defined(TYPE_RAW)
    uint srcIndex = _SrcOffset + dispatchID * 4u;
    uint dstIndex = _DstOffset + dispatchID * 4u;

    if (dispatchID * 4u + 3u < _Size)
    {
        uint4 srcData = _SrcByteBuffer.Load4(srcIndex * 4u);
        _DstByteBuffer.Store4(dstIndex * 4u, srcData);
    }
    else if (dispatchID * 4u + 2u < _Size)
    {
        uint3 srcData = _SrcByteBuffer.Load3(srcIndex * 4u);
        _DstByteBuffer.Store3(dstIndex * 4u, srcData);
    }
    else if (dispatchID * 4u + 1u < _Size)
    {
        uint2 srcData = _SrcByteBuffer.Load2(srcIndex * 4u);
        _DstByteBuffer.Store2(dstIndex * 4u, srcData);
    }
    else if (dispatchID * 4u < _Size)
    {
        uint srcData = _SrcByteBuffer.Load(srcIndex * 4u);
        _DstByteBuffer.Store(dstIndex * 4u, srcData);
    }
#endif
}

//--------------------------------------------------------------------------------------------------
// Scatter
//--------------------------------------------------------------------------------------------------

#if defined(TYPE_RAW_UINT)
static const uint kBytesPerThread = 4u;
#elif defined(TYPE_RAW_UINT4_ALIGNED)
static const uint kBytesPerThread = 16u;
#endif

[numthreads(THREADING_BLOCK_SIZE, 1, 1)]
void ScatterCS(Threading::Group group)
{
    uint dispatchID = UnwrapLinearDispatchThreadID(group);
    uint linearIndex = dispatchID + _SrcOffset;
    uint scatterIndex = linearIndex / _Size;
    uint scatterOffset = linearIndex - scatterIndex * _Size;

    if (scatterIndex < _ScatterCount)
    {
#if defined(TYPE_STRUCTURED)
        uint dstIndex = _ScatterStructuredBuffer[scatterIndex] * _Size + scatterOffset;
        uint srcIndex = dispatchID;
        STRUCTURED_BUFFER_ACCESS(_DstStructuredBuffer, dstIndex) = STRUCTURED_BUFFER_ACCESS(_UploadStructuredBuffer, srcIndex);
#elif defined(TYPE_RAW_UINT)
        uint dstIndex = _ScatterByteBuffer.Load(scatterIndex * 4u) * _Size + scatterOffset;
        uint srcIndex = linearIndex;
        uint srcData = _UploadByteBuffer.Load(srcIndex * kBytesPerThread);
        _DstByteBuffer.Store(dstIndex * kBytesPerThread, srcData);
#elif defined(TYPE_RAW_UINT4_ALIGNED)
        uint dstIndex = _ScatterByteBuffer.Load(scatterIndex * 4u) * _Size + scatterOffset;
        uint srcIndex = linearIndex;
        uint4 srcData = _UploadByteBuffer.Load4(srcIndex * kBytesPerThread);
        _DstByteBuffer.Store4(dstIndex * kBytesPerThread, srcData);
#endif
    }
}

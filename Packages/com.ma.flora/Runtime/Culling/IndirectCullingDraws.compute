//--------------------------------------------------------------------------------------------------
// Definitions
//--------------------------------------------------------------------------------------------------

#pragma kernel ResetDrawArgs
#pragma kernel ScatterDrawArgs

#pragma only_renderers d3d11 playstation xboxone xboxseries vulkan metal switch switch2 webgpu
#pragma use_dxc metal vulkan
// #pragma enable_d3d11_debug_symbols

#pragma multi_compile_local _ DEBUG_ENABLED

#define THREADING_BLOCK_SIZE 64

//--------------------------------------------------------------------------------------------------
// Includes
//--------------------------------------------------------------------------------------------------

#include "Packages/com.ma.flora/Runtime/Graphics/ComputeUtility.hlsl"
#include "Packages/com.ma.flora/Runtime/Culling/IndirectCullingPass.hlsl"
#include "Packages/com.ma.flora/Runtime/Culling/IndirectCulling.hlsl"

//--------------------------------------------------------------------------------------------------
// Kernels
//--------------------------------------------------------------------------------------------------

RWStructuredBuffer<uint> _DrawArgsRW;

[numthreads(THREADING_BLOCK_SIZE, 1, 1)]
void ResetDrawArgs(Threading::Group group)
{
    uint indirectDrawIndex = UnwrapLinearDispatchThreadID(group);
    if (indirectDrawIndex < _DrawCount)
    {
        IndirectDrawInfo drawInfo = _DrawInfos[indirectDrawIndex];
        uint drawArgsOffset = indirectDrawIndex * 5u;
        _DrawArgsRW[drawArgsOffset + 0u] = drawInfo.indexCountPerInstance;
        _DrawArgsRW[drawArgsOffset + 1u] = 0u;
        _DrawArgsRW[drawArgsOffset + 2u] = drawInfo.startIndex;
        _DrawArgsRW[drawArgsOffset + 3u] = drawInfo.baseVertexIndex;
        _DrawArgsRW[drawArgsOffset + 4u] = drawInfo.startInstance;
    }
}

[numthreads(THREADING_BLOCK_SIZE, 1, 1)]
void ScatterDrawArgs(Threading::Group group)
{
    uint drawBinIndex = UnwrapLinearDispatchThreadID(group);
    if (drawBinIndex < _DrawBinCount)
    {
        IndirectDrawBin bin = LoadDrawBin(drawBinIndex);
        if (bin.visibleCount && bin.commandCount)
        {
            uint commandStartOffset = bin.commandStart * 5u;
            for (uint commandIndex = 0u; commandIndex < bin.commandCount; ++commandIndex)
            {
                uint drawArgsOffset = commandStartOffset + commandIndex * 5u;
                uint visibleCountOffset = drawArgsOffset + 1u;
                _DrawArgsRW[visibleCountOffset] = bin.visibleCount;
                IncrementDebugDispatchCounter(kDebugCounterTypeDraws);
            }
        }
    }
}

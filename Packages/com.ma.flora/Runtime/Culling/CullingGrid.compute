//--------------------------------------------------------------------------------------------------
// Definitions
//--------------------------------------------------------------------------------------------------

#pragma kernel UpdateChunkInfos
#pragma kernel UpdateChunkFlags
#pragma kernel UpdateIndirectPages
#pragma kernel UpdateChunkAttributes

#pragma only_renderers d3d11 playstation xboxone xboxseries vulkan metal switch switch2 webgpu
#pragma use_dxc metal vulkan // for testing with newer compiler
// #pragma enable_d3d11_debug_symbols

#define THREADING_BLOCK_SIZE 64 // Max instances per chunk

//--------------------------------------------------------------------------------------------------
// Includes
//--------------------------------------------------------------------------------------------------

#include "Packages/com.ma.flora/Runtime/Graphics/ComputeUtility.hlsl"
#include "Packages/com.ma.flora/Runtime/Core/InstanceBuffer.hlsl"
#include "Packages/com.ma.flora/Runtime/Culling/CullingGrid.hlsl"

//--------------------------------------------------------------------------------------------------
// Chunk Info Updates
//--------------------------------------------------------------------------------------------------

uint _ChunkPacketCount;
StructuredBuffer<CullingChunkUpdatePacket> _ChunkPackets;
RWStructuredBuffer<uint> _CullingChunkCellsRW;
RWStructuredBuffer<uint> _CullingChunkInfosRW;
RWStructuredBuffer<uint> _CullingChunkBatchesRW;

[numthreads(THREADING_BLOCK_SIZE, 1, 1)]
void UpdateChunkInfos(Threading::Group group)
{
    uint packetIndex = UnwrapLinearDispatchThreadID(group);
    if (packetIndex >= _ChunkPacketCount)
        return;

    CullingChunkUpdatePacket packet = _ChunkPackets[packetIndex];
    _CullingChunkCellsRW[packet.chunkIndex] = packet.cellIndex;
    _CullingChunkInfosRW[packet.chunkIndex] = packet.packedInfo;
    _CullingChunkBatchesRW[packet.chunkIndex] = packet.packedBatch;
}

//--------------------------------------------------------------------------------------------------
// Chunk Flag Updates
//--------------------------------------------------------------------------------------------------

uint _ChunkFlagsUpdateCount;
StructuredBuffer<uint> _ChunkFlagIndices;
StructuredBuffer<uint> _ChunkFlagUpdates;
RWStructuredBuffer<uint> _ChunkFlagsRW;

[numthreads(THREADING_BLOCK_SIZE, 1, 1)]
void UpdateChunkFlags(Threading::Group group)
{
    uint flagIndex = UnwrapLinearDispatchThreadID(group);
    if (flagIndex >= _ChunkFlagsUpdateCount)
        return;

    uint chunkIndex = _ChunkFlagIndices[flagIndex];

    for (uint channelIndex = 0; channelIndex < _CullingChunkFlagChannelCount; ++channelIndex)
    {
        uint srcIndex = flagIndex * _CullingChunkFlagChannelCount + channelIndex;
        uint dstIndex = chunkIndex * _CullingChunkFlagChannelCount + channelIndex;
        _ChunkFlagsRW[dstIndex * 2 + 0] = _ChunkFlagUpdates[srcIndex * 2 + 0]; // lower
        _ChunkFlagsRW[dstIndex * 2 + 1] = _ChunkFlagUpdates[srcIndex * 2 + 1]; // upper
    }
}

//--------------------------------------------------------------------------------------------------
// Indirect Page Updates
//--------------------------------------------------------------------------------------------------

uint _IndirectPageUpdateCount;
StructuredBuffer<uint> _IndirectPageUpdates;
StructuredBuffer<uint> _IndirectOffsetUpdates;
RWStructuredBuffer<uint> _IndirectInstanceOffsetsRW;

[numthreads(THREADING_BLOCK_SIZE, 1, 1)]
void UpdateIndirectPages(Threading::Group group)
{
    uint pageUpdateIndex = UnwrapLinearGroupID(group);
    if (pageUpdateIndex >= _IndirectPageUpdateCount)
        return;

    uint packedIndirectPage = _IndirectPageUpdates[pageUpdateIndex];
    uint pageIndex = packedIndirectPage >> 8u;
    uint pageCount = packedIndirectPage & 0xffu;
    if (group.groupIndex >= pageCount)
        return;

    uint srcOffset = pageUpdateIndex * THREADING_BLOCK_SIZE + group.groupIndex;
    uint instanceOffset = _IndirectOffsetUpdates[srcOffset];

    uint dstOffset = pageIndex * THREADING_BLOCK_SIZE + group.groupIndex;
    _IndirectInstanceOffsetsRW[dstOffset] = instanceOffset;
}

//--------------------------------------------------------------------------------------------------
// Chunk Attributes Updates
//--------------------------------------------------------------------------------------------------

uint _ChunkAttributeUpdateCount;
StructuredBuffer<uint2> _AttributeCellChunkIndices;
RWStructuredBuffer<PackedCullingChunkAttributes> _CullingChunkAttributesRW;

[numthreads(THREADING_BLOCK_SIZE, 1, 1)]
void UpdateChunkAttributes(Threading::Group group)
{
    uint cellChunkIndex = UnwrapLinearGroupID(group);
    if (cellChunkIndex >= _ChunkAttributeUpdateCount)
        return;

    uint cellIndex = _AttributeCellChunkIndices[cellChunkIndex].x;
    uint chunkIndex = _AttributeCellChunkIndices[cellChunkIndex].y;

    CellData cellData = LoadCellData(cellIndex);
    CullingChunkBatch cullingChunk = LoadCullingChunkBatch(chunkIndex);

    CullingChunkAttributes attributes;
    attributes.boundsMin = float3(+FLT_MAX, +FLT_MAX, +FLT_MAX);
    attributes.boundsMax = float3(-FLT_MAX, -FLT_MAX, -FLT_MAX);

    if (group.groupIndex < cullingChunk.instanceCount)
    {
        CullingChunkInfo chunkInfo = LoadCullingChunkInfo(chunkIndex);
        BatchCullingAddresses batchAddresses = _BatchCullingAddresses[chunkInfo.batchDomainIndex];
        BindBatchDomainAddresses(batchAddresses);

        float3 worldToBlockTranslation = -cellData.blockData.position;
        uint instanceIndex = cullingChunk.LoadInstanceIndex(group.groupIndex);
        InstanceData instanceData = LoadInstanceData(instanceIndex, group.groupIndex);

        float4x4 blockRelativeTransform = TranslateMatrix(instanceData.localToWorld, worldToBlockTranslation);
        PackedArchetypeData packedArchetypeData = _ArchetypeData[chunkInfo.archetypeIndex];

        float3 localBoundsCenter;
        float3 localBoundsExtent;
        LoadTemplateAABB(packedArchetypeData.templateIndex, localBoundsCenter, localBoundsExtent);

        float3 blockRelativeCenter;
        float3 blockRelativeExtent;
        MatrixTransformBounds(blockRelativeTransform, localBoundsCenter, localBoundsExtent, blockRelativeCenter, blockRelativeExtent);

        float3 blockRelativeMin = blockRelativeCenter - blockRelativeExtent;
        float3 blockRelativeMax = blockRelativeCenter + blockRelativeExtent;

        attributes.boundsMin = min(attributes.boundsMin, blockRelativeMin);
        attributes.boundsMax = max(attributes.boundsMax, blockRelativeMax);
    }

    CullingChunkAttributes groupAttributes;
    groupAttributes.boundsMin.x = group.Min(attributes.boundsMin.x);
    groupAttributes.boundsMin.y = group.Min(attributes.boundsMin.y);
    groupAttributes.boundsMin.z = group.Min(attributes.boundsMin.z);
    groupAttributes.boundsMax.x = group.Max(attributes.boundsMax.x);
    groupAttributes.boundsMax.y = group.Max(attributes.boundsMax.y);
    groupAttributes.boundsMax.z = group.Max(attributes.boundsMax.z);
    GroupMemoryBarrierWithGroupSync();

    if (group.groupIndex == 0)
    {
        float3 cellLocalBoundsMin = cellData.localBoundsCenter - cellData.localBoundsExtent;

        // Normalize to [0,1] range within the cell.
        // Cell extent is doubled because cells have loose half-cellSize padding.

        CullingChunkAttributes normalizedAttributes;
        float3 normalizeScale = rcp(cellData.localBoundsExtent * 2.0);
        normalizedAttributes.boundsMin = saturate((groupAttributes.boundsMin - cellLocalBoundsMin) * normalizeScale);
        normalizedAttributes.boundsMax = saturate((groupAttributes.boundsMax - cellLocalBoundsMin) * normalizeScale);

        PackedCullingChunkAttributes packedAttributes = PackCullingChunkAttributes(normalizedAttributes);
        _CullingChunkAttributesRW[chunkIndex] = packedAttributes;
    }
}

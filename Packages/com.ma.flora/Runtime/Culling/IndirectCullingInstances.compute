//--------------------------------------------------------------------------------------------------
// Definitions
//--------------------------------------------------------------------------------------------------

#pragma kernel CullInstances

#pragma only_renderers d3d11 playstation xboxone xboxseries vulkan metal switch switch2 webgpu
#pragma use_dxc metal vulkan
// #pragma enable_d3d11_debug_symbols

// Core variations
#pragma multi_compile_local _ USE_OCCLUSION
#pragma multi_compile_local _ VIEW_IS_LIGHT

// Development-only variations
#pragma multi_compile_local _ DEBUG_OCCLUSION
#pragma multi_compile_local _ DEBUG_ENABLED

// Editor-only variations
#pragma multi_compile_local _ VIEW_IS_EDITOR

#define THREADING_BLOCK_SIZE 64
#define DRAW_BIN_WRITE

//--------------------------------------------------------------------------------------------------
// Includes
//--------------------------------------------------------------------------------------------------

#include "Packages/com.ma.flora/Runtime/Graphics/ComputeUtility.hlsl"
#include "Packages/com.ma.flora/Runtime/Core/InstanceBuffer.hlsl"
#include "Packages/com.ma.flora/Runtime/Culling/IndirectCullingPass.hlsl"
#include "Packages/com.ma.flora/Runtime/Culling/IndirectCulling.hlsl"

//--------------------------------------------------------------------------------------------------
// Inputs & Outputs
//--------------------------------------------------------------------------------------------------

StructuredBuffer<IndirectDrawPartition> _DrawPartitions;
uint _DensityCullingEnabled;

RWByteAddressBuffer _InstanceVisibilityRW;
uint _InstanceMultiplierShift;

// Development-only uniforms
#ifdef DEBUG_ENABLED
uint _DebugLODMode;
uint _DebugLODIndex;

RWStructuredBuffer<uint> _DebugDrawVisibility;
uint _DebugShadingMode;

uint _DebugErrorCapacity;
#define _DebugErrorEnabled (_DebugErrorCapacity != 0)
RWStructuredBuffer<uint4> _DebugErrorBuffer;
RWStructuredBuffer<uint>  _DebugErrorCount;
#endif

// Editor-only uniforms
#ifdef VIEW_IS_EDITOR
uint _IncludedChunkCount;
StructuredBuffer<uint2> _IncludedInstances;
#endif

//--------------------------------------------------------------------------------------------------
// Instance Kernel Modules
//--------------------------------------------------------------------------------------------------

#include "Packages/com.ma.flora/Runtime/Culling/IndirectCullingInstancesCommon.hlsl"

// Per-thread draw instances
groupshared DrawInstance gs_DrawInstances[kMaxDrawInstances];
groupshared uint gs_PerThreadDrawInstanceCount[THREADING_BLOCK_SIZE];

// Per-chunk histogram: number of bins per (split, binKey, lod)
groupshared uint gs_DrawBinStart[kMaxSplitCount][kMaxDrawStateKeyCount][kMaxLodCount];
groupshared uint gs_DrawBinCount[kMaxSplitCount][kMaxDrawStateKeyCount][kMaxLodCount];

#ifdef VIEW_IS_EDITOR
// Editor-included chunk bits for picking
groupshared uint2 gs_EditorIncludedChunkBits;
#endif

//--------------------------------------------------------------------------------------------------
// Instance Visibility and LOD Helpers
//--------------------------------------------------------------------------------------------------

#include "Packages/com.ma.flora/Runtime/Culling/IndirectCullingInstancesVisibility.hlsl"
#include "Packages/com.ma.flora/Runtime/Culling/IndirectCullingInstancesLod.hlsl"

//--------------------------------------------------------------------------------------------------
// Instance Culling
//--------------------------------------------------------------------------------------------------

StructuredBuffer<CullingWorkGroup> _CullingWorkGroups;
ByteAddressBuffer _CullingWorkGroupArgs;

static const uint kWorkGroupCountOffset = 12u;

[numthreads(THREADING_BLOCK_SIZE, 1, 1)]
void CullInstances(Threading::Group group)
{
    uint workGroupIndex = UnwrapLinearGroupID(group.groupID);
    uint workGroupCount = _CullingWorkGroupArgs.Load(kWorkGroupCountOffset);
    bool isValidWorkGroup = workGroupIndex < workGroupCount;

    CullingWorkGroup workGroup = (CullingWorkGroup)0;
    uint drawChunkIndex = 0;
    uint groupSplitMask = 0;
    if (isValidWorkGroup)
    {
        workGroup = _CullingWorkGroups[workGroupIndex];
        drawChunkIndex = workGroup.drawChunkIndexAndSplitMask >> 8u;
        groupSplitMask = workGroup.drawChunkIndexAndSplitMask & 0xffu;
    }
    uint chunkStateMask = workGroup.supportedStateMask;
    uint drawPartitionIndex = workGroup.drawPartitionIndex;

    if (group.IsFirstThread())
    {
        InitSharedCullingFlags(workGroup.chunkIndex);

#ifdef VIEW_IS_EDITOR
        gs_EditorIncludedChunkBits = kBits64_Full;
        if (_IncludedChunkCount && drawChunkIndex < _IncludedChunkCount)
        {
            gs_EditorIncludedChunkBits = _IncludedInstances[drawChunkIndex];
        }
        else if (_IncludedChunkCount)
        {
            gs_EditorIncludedChunkBits = kBits64_Zero;
        }
#endif

        UNITY_UNROLL
        for (uint split = 0u; split < kMaxSplitCount; ++split)
        for (uint key = 0u; key < kMaxDrawStateKeyCount; ++key)
        for (uint lod = 0u; lod < kMaxLodCount; ++lod)
        {
            gs_DrawBinCount[split][key][lod] = 0u;
            gs_DrawBinStart[split][key][lod] = 0xffffffffu;
        }
    }

    gs_PerThreadDrawInstanceCount[group.groupIndex] = 0u;
    GroupMemoryBarrierWithGroupSync();

    //----------------------------------------------------------------------------------------------
    // Per-thread instance culling
    //----------------------------------------------------------------------------------------------

    CullingChunkBatch chunkBatch =  (CullingChunkBatch)0;
    InstanceData instanceData = (InstanceData)0;
    TemplateData templateData = (TemplateData)0;
    IndirectDrawPartition drawPartition = (IndirectDrawPartition)0;
    PackedArchetypeData archetypeData = (PackedArchetypeData)0;

    uint supportedStateMask = 0u;
    bool isValidInstance = false;
    if (isValidWorkGroup)
    {
        chunkBatch = LoadCullingChunkBatch(workGroup.chunkIndex);
        isValidInstance = chunkBatch.IsValidIndex(group.groupIndex);
    }

    UNITY_BRANCH
    if (isValidInstance)
    {
        CullingChunkInfo chunkInfo = UnpackCullingChunkInfo(workGroup.packedChunkInfo);
        BindBatchDomainAddresses(_BatchCullingAddresses[chunkInfo.batchDomainIndex]);

        uint instanceIndex = chunkBatch.LoadInstanceIndex(group.groupIndex);
        instanceData  = LoadInstanceData(instanceIndex, group.groupIndex);
        archetypeData = LoadArchetypeData(chunkInfo.archetypeIndex);
        templateData  = LoadTemplateData(archetypeData, _ViewMaxRenderDistance, kViewIsLight);
        drawPartition = _DrawPartitions[drawPartitionIndex];

        supportedStateMask = chunkStateMask & drawPartition.stateMask;

        CullingInstanceFlags instanceFlags = LoadSharedCullingInstanceFlags(group.groupIndex);
        CullingInstanceEditorFlags instanceEditorFlags = LoadSharedCullingInstanceEditorFlags(group.groupIndex);
        ComputeInstanceDerivedData(instanceData, templateData, instanceFlags, instanceEditorFlags);

        bool disableCrossFade = ShouldDisableInstanceCrossFade();
        if (disableCrossFade)
        {
            templateData.hasAnimatedFade = false;
            templateData.hasCrossFade = false;
            templateData.maxVisibleLodCount = 1u;
        }

        uint instanceCullingFlags = BuildInstanceCullingFlags(templateData);

        // Keep world-distance culling separate from screen-relative culling so the tighter active fade wins.
        float worldDistToCameraSq = Length2(instanceData.worldCenter - _CameraPosition);
        float screenDistToCameraSq = _CameraIsOrthographic
            ? _ScreenRelativeMetricSq
            : CalculatePerspectiveDistanceSq(instanceData.worldCenter, _CameraPosition, _ScreenRelativeMetricSq);
        float screenDistToCamera = sqrt(screenDistToCameraSq);

        InstanceCuller culler = InstanceCuller::Create(instanceCullingFlags, groupSplitMask, group.groupIndex);
        culler.CullEditorOnly(instanceData);
        culler.CullDevelopmentOnly(templateData);
        culler.CullDistance(templateData, worldDistToCameraSq);
        culler.CullGlobalDensity(instanceData);
        culler.CullRangeDensity(instanceData, screenDistToCamera);
        culler.CullScreenSize(instanceData, screenDistToCamera);
        culler.CullFrustum(instanceData);
        culler.CullOcclusion(instanceData);

        UNITY_BRANCH
        if (culler.visible)
        {
            LODCuller lodCuller = LODCuller::Create(templateData, instanceData);
            lodCuller.CullAndEmitVisibleLods(templateData, instanceData, supportedStateMask, culler.PackFadeValue(), culler.splitMask);
        }
    }

    // Wait for all instances to be processed
    GroupMemoryBarrierWithGroupSync();

    //----------------------------------------------------------------------------------------------
    // Reserve space in each bin
    //----------------------------------------------------------------------------------------------

    if (group.IsFirstThread())
    {
        uint splitCount = min(_ViewSplitCount, kMaxSplitCount);
        uint lodCount = min(templateData.lodCount, kMaxLodCount);

        for (uint split = 0u; split < splitCount; ++split)
        {
            if (((groupSplitMask >> split) & 1u) == 0u)
                continue; // This split is not active for this chunk

            for (uint key = 0u; key < kMaxDrawStateKeyCount; ++key)
            {
                // Find which slot this key maps to, or skip if not present
                uint slot;
                if (!TryGetStateIndexFromKey(drawPartition.stateIndices, key, slot))
                    continue;

                for (uint lod = 0u; lod < lodCount; ++lod)
                {
                    uint countInBin = gs_DrawBinCount[split][key][lod];
                    if (countInBin == 0u)
                        continue; // No instances were emitted for this bin

                    uint drawBinIndex = ComputeBinIndex(templateData, drawPartition, split, slot, lod);
                    IndirectDrawBin drawBin = LoadDrawBin(drawBinIndex);
                    if (drawBin.commandCount)
                    {
                        // _InstanceMultiplierShift is 0 by default, and 1 for stereo rendering (2x count, same indices)
                        uint indexInBin = AddInstancesToDrawBin(drawBinIndex, countInBin << _InstanceMultiplierShift);
                        uint visibilityStart = drawBin.visibleStart + (indexInBin >> _InstanceMultiplierShift);
                        gs_DrawBinStart[split][key][lod] = visibilityStart;
                    }
                    else
                    {
                        DebugEmitError(GPUERRORCODE_COMMAND_COUNT_ZERO, drawBinIndex, countInBin, (split << 16u) | (key << 8u) | lod);
                    }
                }
            }
        }
    }

    // Wait for all bins to be reserved
    GroupMemoryBarrierWithGroupSync();

    //----------------------------------------------------------------------------------------------
    // Finally, write the visible instances to the output buffer
    //----------------------------------------------------------------------------------------------
    // Each thread writes its 0..2 (xfade) instances to the reserved regions

    uint emittedDrawInstances = min(gs_PerThreadDrawInstanceCount[group.groupIndex], kMaxDrawInstancesPerThread);

    for (uint i = 0u; i < emittedDrawInstances; ++i)
    {
        DrawInstance drawInstance = gs_DrawInstances[group.groupIndex * kMaxDrawInstancesPerThread + i];
        uint key = (drawInstance.packedSplitKeyLod >> 8u) & 0xffu;
        uint lod = drawInstance.packedSplitKeyLod & 0xffu;
        uint splitMask = (drawInstance.packedSplitKeyLod >> 16u);
        uint splitCount = min(_ViewSplitCount, kMaxSplitCount);

    #ifdef DEBUG_ENABLED
        if (_DebugErrorEnabled)
        {
            if (key >= kMaxDrawStateKeyCount || lod >= kMaxLodCount)
            {
                DebugEmitError(GPUERRORCODE_PACKED_KEY_OR_LOD_OUT_OF_RANGE, key, lod);
                continue;
            }
        }
    #endif

        for (uint split = 0u; split < splitCount; ++split)
        {
            if (((splitMask >> split) & 1u) == 0u)
                continue;

            uint binStart = gs_DrawBinStart[split][key][lod];
            if (binStart == 0xffffffffu)
                continue; // No space was reserved for this bin

            // Local write offset inside this bin
            uint indexInVisibility;
            InterlockedAdd(gs_DrawBinStart[split][key][lod], 1u, indexInVisibility);

            // Store in the final visibility buffer
            _InstanceVisibilityRW.Store((indexInVisibility << 2u) + 0u, drawInstance.packedFadeAndIndex);
            IncrementDebugDispatchCounter(kDebugCounterTypeVisible);

        #ifdef DEBUG_ENABLED
            if (_DebugShadingMode)
            {
                uint debugSlot;
                if (TryGetStateIndexFromKey(drawPartition.stateIndices, key, debugSlot))
                {
                    uint drawBinIndex = ComputeBinIndex(templateData, drawPartition, split, debugSlot, lod);
                    IndirectDrawBin drawBin = LoadDrawBin(drawBinIndex);

                    uint debugShadingValue = 0u;
                    if (_DebugShadingMode == DEBUGINSTANCEDRAWMODE_LOD)
                        debugShadingValue = lod;
                    else if (_DebugShadingMode == DEBUGINSTANCEDRAWMODE_RANDOM_ID)
                        debugShadingValue = instanceData.randomID;
                    else if (_DebugShadingMode == DEBUGINSTANCEDRAWMODE_TEMPLATE)
                        debugShadingValue = archetypeData.templateIndex;
                    else if (_DebugShadingMode == DEBUGINSTANCEDRAWMODE_DRAW)
                        debugShadingValue = drawBin.commandStart;
                    else if (_DebugShadingMode == DEBUGINSTANCEDRAWMODE_DRAW_VARIANT)
                        debugShadingValue = key;
                    else if (_DebugShadingMode == DEBUGINSTANCEDRAWMODE_CULLING_BATCH)
                        debugShadingValue = workGroup.chunkIndex;
                    else if (_DebugShadingMode == DEBUGINSTANCEDRAWMODE_BATCH_DOMAIN)
                        debugShadingValue = archetypeData.batchDomainIndex;

                    _DebugDrawVisibility[indexInVisibility] = debugShadingValue;
                }
            }
        #endif
        }
    }
}

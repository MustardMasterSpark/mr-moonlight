    uint instanceIndex = chunkHeader.instanceStartIndex + group.groupIndex;
    uint dstAddress    = batchAddress + instanceIndex * 16u;

    _InstanceBufferRW.Store4(dstAddress, _ValuesUint4[valueIndex]);
}

//--------------------------------------------------------------------------------------------------
// Copy Components
//--------------------------------------------------------------------------------------------------

static const uint kBytesPerThread = 4;
static const uint kBytesPerGroup  = THREADING_BLOCK_SIZE * kBytesPerThread;

uint _CommandCount;
StructuredBuffer<BufferCopyCommand> _CopyCommands;

ByteAddressBuffer _SrcBuffer;
RWByteAddressBuffer _DstBuffer;

void ExecuteCopy(BufferCopyCommand cmd, uint groupIndex)
{
    uint totalBytes = cmd.stride * cmd.count;
    uint numFullWaves = totalBytes / kBytesPerGroup;

    uint srcIndex = groupIndex * kBytesPerThread;
    uint dstIndex = groupIndex * kBytesPerThread;
    for (uint i = 0; i < numFullWaves; i += 1)
    {
        uint value = _SrcBuffer.Load(srcIndex + cmd.srcAddress);
        _DstBuffer.Store(dstIndex + cmd.dstAddress, value);
        srcIndex += kBytesPerGroup;
        dstIndex += kBytesPerGroup;
    }

    if (dstIndex < totalBytes)
    {
        uint value = _SrcBuffer.Load(srcIndex + cmd.srcAddress);
        _DstBuffer.Store(dstIndex + cmd.dstAddress, value);
    }
}

[numthreads(THREADING_BLOCK_SIZE, 1, 1)]
void CopyComponents(Threading::Group group)
{
    int commandIndex = UnwrapLinearGroupID(group);
    if (commandIndex >= _CommandCount)
        return;

    BufferCopyCommand cmd = _CopyCommands[commandIndex];
    ExecuteCopy(cmd, group.groupIndex);
}

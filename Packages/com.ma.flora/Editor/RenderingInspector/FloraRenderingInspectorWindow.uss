.flora-rendering-inspector {
    flex-grow: 1;
    background-color: var(--unity-colors-window-background);
    color: var(--unity-colors-default-text);
}

.flora-rendering-inspector__overview {
    height: 28px;
    min-height: 28px;
    padding-left: 8px;
    padding-right: 6px;
    padding-top: 3px;
    padding-bottom: 3px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
    background-color: var(--unity-colors-toolbar-background);
}

.flora-rendering-inspector__icon-button-control {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    width: 24px;
    height: 21px;
    min-height: 21px;
    padding-left: 3px;
    padding-right: 3px;
    background-color: #3f3f3f;
    border-color: #2a2a2a;
    border-width: 1px;
    border-radius: 3px;
}

.flora-rendering-inspector__icon-button-icon {
    width: 15px;
    min-width: 15px;
    height: 15px;
    min-height: 15px;
    margin-right: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--unity-colors-default-text);
}

.flora-rendering-inspector__icon-button-label {
    margin-left: 4px;
    font-size: 11px;
}

.flora-rendering-inspector__object-button--overview .flora-rendering-inspector__icon-button-icon,
.flora-rendering-inspector__object-button--overview .flora-editor-icon-button__icon {
    background-image: var(--flora-overview-icon);
}

.flora-rendering-inspector__object-button--refresh .flora-rendering-inspector__icon-button-icon,
.flora-rendering-inspector__object-button--refresh .flora-editor-icon-button__icon {
    background-image: var(--flora-refresh-icon);
}

.flora-rendering-inspector__object-button--frame .flora-rendering-inspector__icon-button-icon,
.flora-rendering-inspector__object-button--frame .flora-editor-icon-button__icon {
    background-image: var(--flora-frame-icon);
}

.flora-rendering-inspector__icon-action {
    margin-left: 0;
    margin-right: 4px;
}

.flora-rendering-inspector__icon-action:hover {
    background-color: #4a4a4a;
    border-color: #5c5c5c;
}

.flora-rendering-inspector__icon-action:active {
    background-color: #343434;
    border-color: #57AEFF;
}

.flora-rendering-inspector__icon-action:focus {
    border-color: #57AEFF;
}

.flora-rendering-inspector__refresh-button {
    min-width: 24px;
}

.flora-rendering-inspector__summary-button {
    min-width: 24px;
}

.flora-rendering-inspector__search-container {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 21px;
    min-height: 21px;
    margin: 0;
    flex-direction: row;
    align-items: center;
    background-color: #454545;
    border-color: #323232;
    border-width: 1px;
    border-radius: 6px;
}

.flora-rendering-inspector__search-container:hover {
    background-color: #494949;
    border-color: #5a5a5a;
}

.flora-rendering-inspector__search-container--focused {
    border-color: #57AEFF;
}

.flora-rendering-inspector__search-icon {
    width: 17px;
    height: 17px;
    min-width: 17px;
    margin-left: 5px;
    margin-right: 4px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #bcbcbc;
    background-image: var(--flora-search-icon);
}

.flora-rendering-inspector__search-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 21px;
    min-height: 21px;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    font-size: 12px;
    -unity-text-align: middle-left;
}

.flora-rendering-inspector__options-menu {
    min-width: 24px;
    width: 24px;
    height: 21px;
    min-height: 21px;
    margin-left: 4px;
    padding-left: 0;
    padding-right: 0;
    background-color: #3f3f3f;
    border-color: #2a2a2a;
    border-width: 1px;
    border-radius: 3px;
    background-image: var(--flora-more-icon);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: #bcbcbc;
}

.flora-rendering-inspector__options-menu:hover {
    background-color: #4a4a4a;
    border-color: #5c5c5c;
}

.flora-rendering-inspector__options-menu:active {
    background-color: #343434;
    border-color: #57AEFF;
}

.flora-rendering-inspector__options-menu:focus {
    border-color: #57AEFF;
}

.flora-rendering-inspector__options-menu .unity-toolbar-menu__arrow {
    display: none;
}

.flora-rendering-inspector__options-menu .unity-toolbar-menu__text {
    display: none;
}

.flora-rendering-inspector__search-field .unity-base-text-field__input {
    min-height: 21px;
    height: 21px;
    margin: 0;
    padding-left: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    font-size: 12px;
    -unity-text-align: middle-left;
}

.flora-rendering-inspector__search-field #unity-text-input {
    top: 2px;
    min-height: 17px;
    height: 17px;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 12px;
    -unity-text-align: middle-left;
}

.flora-rendering-inspector__split-view {
    flex-grow: 1;
}

.flora-rendering-inspector__browser-pane {
    flex-grow: 1;
    min-width: 320px;
    border-right-width: 1px;
    border-right-color: var(--unity-colors-default-border);
}

.flora-rendering-inspector__browser-tabs {
    height: 28px;
    min-height: 28px;
    flex-direction: row;
    align-items: center;
    padding-left: 6px;
    padding-right: 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
    background-color: rgba(128, 128, 128, 0.055);
}

.flora-rendering-inspector__browser-tab-list {
    flex-direction: row;
    align-items: flex-end;
    flex-grow: 1;
    min-width: 0;
    height: 28px;
}

.flora-rendering-inspector__browser-tab {
    height: 24px;
    min-height: 24px;
    margin-right: 8px;
    padding-left: 1px;
    padding-right: 1px;
    padding-top: 5px;
    padding-bottom: 4px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    opacity: 0.72;
    -unity-text-align: middle-center;
}

.flora-rendering-inspector__browser-tab:hover {
    opacity: 0.92;
}

.flora-rendering-inspector__browser-tab--active {
    opacity: 1;
    border-bottom-color: #57AEFF;
}

.flora-rendering-inspector__sort-menu {
    min-width: 22px;
    width: 22px;
    height: 20px;
    min-height: 20px;
    margin-left: 4px;
    padding-left: 0;
    padding-right: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--unity-colors-default-text);
    background-image: var(--flora-filter-icon);
}

.flora-rendering-inspector__sort-menu .unity-toolbar-menu__arrow {
    display: none;
}

.flora-rendering-inspector__empty-state {
    position: absolute;
    left: 0;
    right: 0;
    top: 80px;
    -unity-text-align: middle-center;
    opacity: 0.65;
}

.flora-rendering-inspector__details {
    flex-grow: 1;
    min-width: 300px;
    background-color: var(--unity-colors-window-background);
}

.flora-rendering-inspector__selection-strip {
    min-height: 54px;
    flex-direction: row;
    align-items: center;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 5px;
    padding-bottom: 5px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
    background-color: rgba(128, 128, 128, 0.06);
}

.flora-rendering-inspector__selection-strip .flora-rendering-inspector__details-icon {
    width: 32px;
    min-width: 32px;
    height: 32px;
    min-height: 32px;
    margin-right: 0;
    flex-grow: 0;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.flora-rendering-inspector__selection-labels {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    justify-content: center;
    margin-left: 5px;
}

.flora-rendering-inspector__selection-title {
    -unity-font-style: bold;
    font-size: 12px;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

.flora-rendering-inspector__selection-subtitle {
    font-size: 11px;
    margin: 5px 0 0 0;
    padding: 0;
    opacity: 0.68;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.flora-rendering-inspector__preview {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 5px;
}

.flora-rendering-inspector__chip {
    margin-right: 4px;
    margin-bottom: 2px;
    padding-left: 4px;
    padding-right: 4px;
    border-radius: 3px;
    background-color: rgba(128, 128, 128, 0.24);
    font-size: 10px;
}

.flora-rendering-inspector__details-content {
    flex-grow: 1;
}

.flora-rendering-inspector__overview-grid {
    padding-top: 4px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.18);
    background-color: rgba(128, 128, 128, 0.025);
}

.flora-rendering-inspector__detail-row {
    flex-direction: row;
    align-items: center;
    min-height: 20px;
    padding-left: 8px;
    padding-right: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.14);
}

.flora-rendering-inspector__object-row {
    min-height: 22px;
}

.flora-rendering-inspector__detail-label {
    width: 128px;
    min-width: 128px;
    font-size: 11px;
    opacity: 0.72;
    -unity-text-align: middle-left;
}

.flora-rendering-inspector__detail-value {
    flex-grow: 1;
    min-width: 0;
    font-size: 11px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.flora-rendering-inspector__detail-object-field {
    flex-grow: 1;
    min-width: 80px;
    margin-left: 0;
    margin-right: 3px;
}

.flora-rendering-inspector__detail-object-field-container {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 80px;
    flex-direction: row;
}

.flora-rendering-inspector__object-button {
    width: 20px;
    min-width: 20px;
    height: 18px;
    min-height: 18px;
    margin-left: 2px;
    padding-left: 1px;
    padding-right: 1px;
    border-width: 0;
}

.flora-rendering-inspector__object-button--ping {
}

.flora-rendering-inspector__object-button--select {
}

.flora-rendering-inspector__relationship-row {
    flex-direction: row;
    align-items: center;
    min-height: 20px;
    padding-left: 24px;
    padding-right: 4px;
}

.flora-rendering-inspector__relationship-row--selectable:hover {
    background-color: rgba(128, 128, 128, 0.12);
}

.flora-rendering-inspector-relationship-list {
    flex-direction: column;
    flex-shrink: 0;
}

.flora-rendering-inspector__relationship-labels {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.flora-rendering-inspector__relationship-name {
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 11px;
}

.flora-rendering-inspector__relationship-count {
    width: 64px;
    min-width: 64px;
    -unity-text-align: middle-right;
    opacity: 0.74;
}

.flora-rendering-inspector__show-all-row {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
    padding-left: 24px;
    padding-right: 6px;
    border-top-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.12);
}

.flora-rendering-inspector__show-all-summary {
    flex-grow: 1;
    opacity: 0.62;
    font-size: 11px;
}

.flora-rendering-inspector__show-all-button {
    min-height: 18px;
    height: 18px;
    font-size: 10px;
    padding-left: 6px;
    padding-right: 6px;
}

.flora-rendering-inspector__warning {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    margin: 0;
    min-height: 32px;
    padding-left: 9px;
    padding-right: 9px;
    padding-top: 6px;
    padding-bottom: 6px;
    border-left-width: 2px;
    border-left-color: #E5A94A;
    border-bottom-width: 1px;
    border-bottom-color: rgba(229, 169, 74, 0.20);
    background-color: rgba(229, 169, 74, 0.13);
}

.flora-rendering-inspector__warning-icon {
    width: 16px;
    height: 16px;
    min-width: 16px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: var(--flora-warning-icon);
}

.flora-rendering-inspector__warning-label {
    flex-grow: 1;
    min-width: 0;
    font-size: 11px;
    white-space: normal;
}

.flora-rendering-inspector-tab-view {
    flex-direction: column;
    margin-left: 0;
    margin-right: 0;
    flex-shrink: 1;
    flex-grow: 1;
}

.flora-rendering-inspector-tab-view__tab-header {
    flex-direction: row;
    flex-shrink: 0;
    flex-wrap: nowrap;
    height: 20px;
    min-height: 20px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 1px;
    padding-bottom: 0;
    margin-bottom: 5px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.2);
    background-color: rgba(0, 0, 0, 0.18);
}

.flora-rendering-inspector-tab-view__tab {
    flex-grow: 0;
    flex-shrink: 1;
    height: 20px;
    min-height: 20px;
    margin-right: 0;
    padding-left: 14px;
    padding-right: 14px;
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    font-size: 11px;
    -unity-text-align: middle-center;
}

.flora-rendering-inspector-tab-view__tab:hover {
    border-bottom-width: 1px;
    border-bottom-color: #2196F3;
    background-color: rgba(128, 128, 128, 0.08);
}

.flora-rendering-inspector-tab-view__tab--active,
.flora-rendering-inspector-tab-view__tab--active:hover {
    border-bottom-width: 2px;
    border-bottom-color: #57AEFF;
    background-color: rgba(0, 0, 0, 0);
}

.flora-rendering-inspector-tab-view__tab-content {
    flex-grow: 1;
    flex-shrink: 1;
    background-color: rgba(128, 128, 128, 0.025);
}

.flora-rendering-inspector__lod-tab-page {
    flex-direction: column;
}

.flora-rendering-inspector__section--inactive {
    opacity: 0.68;
}

.flora-rendering-inspector__batch-property--inactive {
    opacity: 0.72;
}

.flora-rendering-inspector-shader-property-section {
    flex-shrink: 0;
}

.flora-rendering-inspector-shader-property-section--inherited .flora-rendering-inspector-section__label {
    opacity: 0.82;
}

.flora-rendering-inspector__batch-property--inactive .flora-rendering-inspector-section__toggle {
    background-color: rgba(128, 128, 128, 0.035);
}

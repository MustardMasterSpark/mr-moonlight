.flora-rendering-inspector__browser-tree {
    flex-grow: 1;
    border-width: 0;
}

.flora-rendering-inspector__browser-row {
    flex-direction: row;
    align-items: center;
    height: 24px;
    min-height: 24px;
    padding-left: 0;
    padding-right: 3px;
    background-color: transparent;
}

.flora-rendering-inspector__browser-column {
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

.flora-rendering-inspector__browser-column--main {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    -unity-overflow-clip-box: content-box;
    padding-left: 2px;
}

.flora-rendering-inspector__browser-column--meta {
    flex-shrink: 0;
    justify-content: flex-end;
}

.flora-rendering-inspector__browser-row--child {
    opacity: 0.92;
}

.flora-rendering-inspector__browser-icon,
.flora-rendering-inspector__details-icon,
.flora-rendering-inspector__relationship-icon {
    width: 16px;
    height: 16px;
    min-width: 16px;
    min-height: 16px;
    margin-right: 5px;
    -unity-background-scale-mode: scale-to-fit;
}

.flora-rendering-inspector__browser-icon {
    position: relative;
}

.flora-rendering-inspector__browser-icon--overview,
.flora-rendering-inspector__relationship-icon--overview,
.flora-rendering-inspector__details-icon--overview {
    background-image: var(--flora-overview-icon);
}

.flora-rendering-inspector__browser-icon--summary,
.flora-rendering-inspector__relationship-icon--summary,
.flora-rendering-inspector__details-icon--summary {
    background-image: var(--flora-summary-icon);
}

.flora-rendering-inspector__browser-icon--group,
.flora-rendering-inspector__relationship-icon--group,
.flora-rendering-inspector__details-icon--group {
    background-image: var(--flora-group-icon);
}

.flora-rendering-inspector__browser-icon--source,
.flora-rendering-inspector__relationship-icon--source,
.flora-rendering-inspector__details-icon--source {
    background-image: var(--flora-source-icon);
}

.flora-rendering-inspector__browser-icon--container,
.flora-rendering-inspector__relationship-icon--container,
.flora-rendering-inspector__details-icon--container {
    background-image: var(--flora-container-icon);
}

.flora-rendering-inspector__browser-icon--renderer,
.flora-rendering-inspector__relationship-icon--renderer,
.flora-rendering-inspector__details-icon--renderer {
    background-image: var(--flora-renderer-icon);
}

.flora-rendering-inspector__browser-icon--prefab,
.flora-rendering-inspector__relationship-icon--prefab,
.flora-rendering-inspector__details-icon--prefab {
    background-image: var(--flora-prefab-icon);
}

.flora-rendering-inspector__browser-icon--template,
.flora-rendering-inspector__relationship-icon--template,
.flora-rendering-inspector__details-icon--template,
.flora-rendering-inspector__browser-icon--template-lodgroup,
.flora-rendering-inspector__relationship-icon--template-lodgroup,
.flora-rendering-inspector__details-icon--template-lodgroup,
.flora-rendering-inspector__browser-icon--template-meshrenderer,
.flora-rendering-inspector__relationship-icon--template-meshrenderer,
.flora-rendering-inspector__details-icon--template-meshrenderer,
.flora-rendering-inspector__browser-icon--template-meshlod,
.flora-rendering-inspector__relationship-icon--template-meshlod,
.flora-rendering-inspector__details-icon--template-meshlod,
.flora-rendering-inspector__browser-icon--template-billboard,
.flora-rendering-inspector__relationship-icon--template-billboard,
.flora-rendering-inspector__details-icon--template-billboard {
    background-image: var(--flora-template-icon);
}

.flora-rendering-inspector__browser-icon--lod,
.flora-rendering-inspector__relationship-icon--lod,
.flora-rendering-inspector__details-icon--lod {
    background-image: var(--flora-lod-icon);
}

.flora-rendering-inspector__browser-icon--draw,
.flora-rendering-inspector__relationship-icon--draw,
.flora-rendering-inspector__details-icon--draw {
    background-image: var(--flora-draw-icon);
}

.flora-rendering-inspector__browser-icon--domain,
.flora-rendering-inspector__relationship-icon--domain,
.flora-rendering-inspector__details-icon--domain {
    background-image: var(--flora-domain-icon);
}

.flora-rendering-inspector__browser-icon--archetype,
.flora-rendering-inspector__relationship-icon--archetype,
.flora-rendering-inspector__details-icon--archetype {
    background-image: var(--flora-archetype-icon);
}

.flora-rendering-inspector__browser-icon--chunk,
.flora-rendering-inspector__relationship-icon--chunk,
.flora-rendering-inspector__details-icon--chunk {
    background-image: var(--flora-chunk-icon);
}

.flora-rendering-inspector__browser-icon--grid,
.flora-rendering-inspector__relationship-icon--grid,
.flora-rendering-inspector__details-icon--grid {
    background-image: var(--flora-grid-icon);
}

.flora-rendering-inspector__browser-icon--grid-block,
.flora-rendering-inspector__relationship-icon--grid-block,
.flora-rendering-inspector__details-icon--grid-block {
    background-image: var(--flora-grid-block-icon);
}

.flora-rendering-inspector__browser-icon--grid-cell,
.flora-rendering-inspector__relationship-icon--grid-cell,
.flora-rendering-inspector__details-icon--grid-cell {
    background-image: var(--flora-grid-cell-icon);
}

.flora-rendering-inspector__browser-icon--grid-chunk,
.flora-rendering-inspector__relationship-icon--grid-chunk,
.flora-rendering-inspector__details-icon--grid-chunk,
.flora-rendering-inspector__browser-icon--culling-chunk,
.flora-rendering-inspector__relationship-icon--culling-chunk,
.flora-rendering-inspector__details-icon--culling-chunk {
    background-image: var(--flora-grid-chunk-icon);
}

.flora-rendering-inspector__browser-icon--culling,
.flora-rendering-inspector__relationship-icon--culling,
.flora-rendering-inspector__details-icon--culling {
    background-image: var(--flora-culling-icon);
}

.flora-rendering-inspector__browser-icon--culling-cpu,
.flora-rendering-inspector__relationship-icon--culling-cpu,
.flora-rendering-inspector__details-icon--culling-cpu {
    background-image: var(--flora-culling-cpu-icon);
}

.flora-rendering-inspector__browser-icon--culling-gpu,
.flora-rendering-inspector__relationship-icon--culling-gpu,
.flora-rendering-inspector__details-icon--culling-gpu {
    background-image: var(--flora-culling-gpu-icon);
}

.flora-rendering-inspector__browser-icon--buffer,
.flora-rendering-inspector__relationship-icon--buffer,
.flora-rendering-inspector__details-icon--buffer {
    background-image: var(--flora-buffer-icon);
}

.flora-rendering-inspector__browser-icon--property,
.flora-rendering-inspector__relationship-icon--property,
.flora-rendering-inspector__details-icon--property {
    background-image: var(--flora-property-icon);
}

.flora-rendering-inspector__browser-icon--property-instance,
.flora-rendering-inspector__relationship-icon--property-instance,
.flora-rendering-inspector__details-icon--property-instance {
    background-image: var(--flora-property-instance-icon);
}

.flora-rendering-inspector__browser-icon--property-shared,
.flora-rendering-inspector__relationship-icon--property-shared,
.flora-rendering-inspector__details-icon--property-shared {
    background-image: var(--flora-property-shared-icon);
}

.flora-rendering-inspector__browser-icon--property-mixed,
.flora-rendering-inspector__relationship-icon--property-mixed,
.flora-rendering-inspector__details-icon--property-mixed {
    background-image: var(--flora-property-mixed-icon);
}

.flora-rendering-inspector__browser-icon--property-metadata,
.flora-rendering-inspector__relationship-icon--property-metadata,
.flora-rendering-inspector__details-icon--property-metadata {
    background-image: var(--flora-property-metadata-icon);
}

.flora-rendering-inspector__browser-row--generic-icon .flora-rendering-inspector__browser-icon {
    opacity: 0.78;
}

.flora-rendering-inspector__browser-row--thumbnail .flora-rendering-inspector__browser-icon {
    opacity: 1;
}

.flora-rendering-inspector__browser-body {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
}

.flora-rendering-inspector__browser-name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
    padding: 0;
    margin: 0;
}

.flora-rendering-inspector__browser-row--root .flora-rendering-inspector__browser-name {
    -unity-font-style: bold;
}

.flora-rendering-inspector__browser-row--section {
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.22);
    background-color: rgba(128, 128, 128, 0.045);
}

.flora-rendering-inspector__browser-row--section .flora-rendering-inspector__browser-name {
    -unity-font-style: bold;
    opacity: 0.95;
}

.flora-rendering-inspector__browser-row--section .flora-rendering-inspector__browser-icon {
    opacity: 0.9;
}

.flora-rendering-inspector__browser-badge {
    width: 58px;
    min-width: 58px;
    max-width: 58px;
    margin-left: 5px;
    margin-right: 4px;
    padding-left: 4px;
    padding-right: 4px;
    border-radius: 3px;
    background-color: rgba(128, 128, 128, 0.20);
    color: var(--unity-colors-default-text);
    opacity: 0.78;
    font-size: 10px;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-center;
}

.flora-rendering-inspector__browser-badge--level-0 {
    background-color: rgba(74, 144, 226, 0.26);
}

.flora-rendering-inspector__browser-badge--level-1 {
    background-color: rgba(54, 171, 196, 0.26);
}

.flora-rendering-inspector__browser-badge--level-2 {
    background-color: rgba(62, 178, 132, 0.26);
}

.flora-rendering-inspector__browser-badge--level-3 {
    background-color: rgba(130, 178, 82, 0.26);
}

.flora-rendering-inspector__browser-badge--level-4 {
    background-color: rgba(219, 164, 66, 0.30);
}

.flora-rendering-inspector__browser-badge--level-5 {
    background-color: rgba(218, 118, 70, 0.30);
}

.flora-rendering-inspector__browser-badge--level-6 {
    background-color: rgba(198, 84, 84, 0.30);
}

.flora-rendering-inspector__browser-badge--unassigned {
    background-color: rgba(128, 128, 128, 0.18);
    opacity: 0.62;
}

.flora-rendering-inspector__browser-count {
    width: 70px;
    min-width: 70px;
    -unity-text-align: middle-right;
    opacity: 0.82;
}

.flora-rendering-inspector__browser-frame-button {
    width: 18px;
    min-width: 18px;
    height: 18px;
    min-height: 18px;
    margin-left: 2px;
    margin-right: 2px;
    padding-left: 1px;
    padding-right: 1px;
    border-width: 0;
    opacity: 0.74;
}

.flora-rendering-inspector__browser-frame-button:hover {
    opacity: 1;
}

.flora-rendering-inspector__browser-warning {
    position: absolute;
    right: -2px;
    top: -2px;
    width: 7px;
    height: 7px;
    min-width: 7px;
    min-height: 7px;
    border-radius: 5px;
    border-width: 1px;
    border-color: var(--unity-colors-window-background);
    background-color: #E5A94A;
}

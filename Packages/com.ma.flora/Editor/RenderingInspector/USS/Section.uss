.flora-rendering-inspector__section,
.flora-rendering-inspector-section {
    flex-shrink: 0;
    margin: 0;
    align-self: stretch;
}

.flora-rendering-inspector-section__toggle {
    height: 24px;
    min-height: 24px;
    margin: 0;
    padding: 0;
    flex-direction: row;
    align-items: center;
    -unity-text-align: middle-left;
    background-color: rgba(128, 128, 128, 0.06);
    border-top-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.12);
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.18);
}

.flora-rendering-inspector-section__toggle:hover {
    background-color: rgba(128, 128, 128, 0.14);
}

.flora-rendering-inspector-section__toggle-icon {
    flex-grow: 0;
    flex-shrink: 0;
    width: 13px;
    min-width: 13px;
    height: 13px;
    min-height: 13px;
    margin-left: 1px;
    margin-right: 0;
    padding: 0;
    align-self: center;
}

.flora-rendering-inspector-section__header {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    align-items: center;
    height: 24px;
    min-height: 24px;
    padding: 0 6px 0 1px;
}

.flora-rendering-inspector-section__icon {
    flex-grow: 0;
    flex-shrink: 0;
    width: 16px;
    min-width: 16px;
    height: 16px;
    min-height: 16px;
    margin-right: 4px;
    opacity: 0.82;
    -unity-background-scale-mode: scale-to-fit;
}

.flora-rendering-inspector-section__icon--overview {
    background-image: var(--flora-overview-icon);
}

.flora-rendering-inspector-section__icon--buffer {
    background-image: var(--flora-buffer-icon);
}

.flora-rendering-inspector-section__icon--draw {
    background-image: var(--flora-draw-icon);
}

.flora-rendering-inspector-section__icon--domain {
    background-image: var(--flora-domain-icon);
}

.flora-rendering-inspector-section__icon--property {
    background-image: var(--flora-property-icon);
}

.flora-rendering-inspector-section__icon--group {
    background-image: var(--flora-group-icon);
}

.flora-rendering-inspector-section__icon--source {
    background-image: var(--flora-source-icon);
}

.flora-rendering-inspector-section__icon--archetype {
    background-image: var(--flora-archetype-icon);
}

.flora-rendering-inspector-section__icon--chunk {
    background-image: var(--flora-chunk-icon);
}

.flora-rendering-inspector-section__icon--grid {
    background-image: var(--flora-grid-icon);
}

.flora-rendering-inspector-section__icon--culling {
    background-image: var(--flora-culling-icon);
}

.flora-rendering-inspector-section__icon--culling-cpu {
    background-image: var(--flora-culling-cpu-icon);
}

.flora-rendering-inspector-section__icon--culling-gpu {
    background-image: var(--flora-culling-gpu-icon);
}

.flora-rendering-inspector-section__icon--grid-chunk {
    background-image: var(--flora-grid-chunk-icon);
}

.flora-rendering-inspector-section__icon--lod {
    background-image: var(--flora-lod-icon);
}

.flora-rendering-inspector-section__label-container {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    align-items: center;
}

.flora-rendering-inspector-section__label {
    margin: 0;
    padding: 0;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.flora-rendering-inspector-section__summary {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-left: 8px;
    opacity: 0.62;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 10px;
    -unity-text-align: middle-right;
}

.flora-rendering-inspector-section__count {
    height: 16px;
    min-height: 16px;
    min-width: 24px;
    margin-left: 6px;
    padding-left: 4px;
    padding-right: 4px;
    border-radius: 2px;
    background-color: rgba(128, 128, 128, 0.18);
    opacity: 0.78;
    font-size: 10px;
    -unity-text-align: middle-center;
}

.flora-rendering-inspector-section__content {
    flex-direction: column;
    margin-left: 0;
    padding-top: 2px;
}

.flora-rendering-inspector-section--nested {
    margin-left: 14px;
}

.flora-rendering-inspector-section--nested .flora-rendering-inspector-section__toggle {
    background-color: rgba(128, 128, 128, 0.035);
}

.flora-rendering-inspector-section--nested .flora-rendering-inspector-section__content {
    padding-top: 0;
}

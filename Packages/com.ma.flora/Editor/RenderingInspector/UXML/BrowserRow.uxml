<UXML xmlns:ui="UnityEngine.UIElements">
  <ui:VisualElement class="flora-rendering-inspector__browser-row">
    <ui:VisualElement name="Column 1" class="flora-rendering-inspector__browser-column flora-rendering-inspector__browser-column--main">
      <ui:VisualElement name="Icon" class="flora-rendering-inspector__browser-icon">
        <ui:VisualElement name="Warning" class="flora-rendering-inspector__browser-warning" />
      </ui:VisualElement>
      <ui:VisualElement name="Labels" class="flora-rendering-inspector__browser-body">
        <ui:Label name="Name" class="flora-rendering-inspector__browser-name" display-tooltip-when-elided="true" />
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="Column 2" class="flora-rendering-inspector__browser-column flora-rendering-inspector__browser-column--meta">
      <ui:Label name="Badge" class="flora-rendering-inspector__browser-badge" display-tooltip-when-elided="true" />
      <ui:Button name="Frame" class="flora-rendering-inspector__icon-button-control flora-rendering-inspector__browser-frame-button flora-rendering-inspector__object-button--frame">
        <ui:VisualElement name="Icon" class="flora-rendering-inspector__icon-button-icon" />
        <ui:Label name="Label" class="flora-rendering-inspector__icon-button-label" />
      </ui:Button>
      <ui:Label name="Count" class="flora-rendering-inspector__browser-count" />
    </ui:VisualElement>
  </ui:VisualElement>
</UXML>

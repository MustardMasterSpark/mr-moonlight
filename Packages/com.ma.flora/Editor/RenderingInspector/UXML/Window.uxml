<UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
  <ui:VisualElement name="Toolbar" class="flora-rendering-inspector__overview">
    <ui:Button name="SummaryButton" class="flora-editor-icon-button flora-rendering-inspector__icon-action flora-rendering-inspector__summary-button flora-rendering-inspector__object-button--overview">
      <ui:VisualElement name="Icon" class="flora-editor-icon-button__icon flora-rendering-inspector__icon-button-icon" />
      <ui:Label name="Label" class="flora-editor-icon-button__label flora-rendering-inspector__icon-button-label" />
    </ui:Button>
    <ui:Button name="RefreshButton" class="flora-editor-icon-button flora-rendering-inspector__icon-action flora-rendering-inspector__refresh-button flora-rendering-inspector__object-button--refresh">
      <ui:VisualElement name="Icon" class="flora-editor-icon-button__icon flora-rendering-inspector__icon-button-icon" />
      <ui:Label name="Label" class="flora-editor-icon-button__label flora-rendering-inspector__icon-button-label" />
    </ui:Button>
    <ui:VisualElement name="SearchContainer" class="flora-rendering-inspector__search-container">
      <ui:VisualElement name="SearchIcon" class="flora-rendering-inspector__search-icon" />
      <ui:TextField name="SearchField" class="flora-rendering-inspector__search-field" />
    </ui:VisualElement>
    <uie:ToolbarMenu name="OptionsMenu" text="" class="flora-rendering-inspector__options-menu" />
  </ui:VisualElement>
</UXML>

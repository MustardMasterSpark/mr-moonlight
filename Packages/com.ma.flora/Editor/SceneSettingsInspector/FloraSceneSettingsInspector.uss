.flora-scene-settings__status-chips {
    margin-left: 2px;
    margin-right: 8px;
}

.flora-scene-settings__status-chip {
    min-height: 17px;
    margin-left: 0;
    margin-right: 4px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 0;
    padding-bottom: 0;
    border-width: 1px;
    border-radius: 3px;
    border-color: rgba(128, 128, 128, 0.24);
    background-color: rgba(128, 128, 128, 0.08);
    opacity: 0.72;
    font-size: 11px;
    -unity-text-align: middle-center;
    overflow: hidden;
    text-overflow: ellipsis;
}

.flora-scene-settings__status-chip:hover {
    opacity: 0.92;
}

.flora-scene-settings__status-chip--active {
    opacity: 1;
    border-color: rgba(87, 174, 255, 0.70);
    background-color: rgba(87, 174, 255, 0.14);
    color: #C7E6FF;
}

.flora-scene-settings__status-chip--inactive {
    opacity: 0.58;
}

.flora-scene-settings__graphics-settings-button .flora-editor-icon-button__icon {
    background-image: resource("d_SettingsIcon");
}

.flora-scene-settings__terrain-auto-toggle.flora-editor-icon-toggle-button--on:hover,
.flora-scene-settings__terrain-auto-toggle.flora-editor-icon-toggle-button--on:focus {
    border-color: #57AEFF;
    background-color: rgba(87, 174, 255, 0.20);
}

.flora-scene-settings__terrain-auto-toggle.flora-editor-icon-toggle-button--on:hover .flora-editor-icon-button__icon,
.flora-scene-settings__terrain-auto-toggle.flora-editor-icon-toggle-button--on:focus .flora-editor-icon-button__icon {
    -unity-background-image-tint-color: #9BD0FF;
}

.flora-scene-settings__terrain-auto-toggle.flora-editor-icon-toggle-button--off:hover,
.flora-scene-settings__terrain-auto-toggle.flora-editor-icon-toggle-button--off:focus {
    background-color: rgba(128, 128, 128, 0.12);
    border-color: rgba(128, 128, 128, 0.38);
}

.flora-scene-settings__settings-content {
    flex-direction: column;
}

.flora-scene-settings__stats-content {
    flex-direction: column;
}

.flora-scene-settings__stats-inactive {
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
}

.flora-scene-settings__settings-content--disabled {
    opacity: 0.55;
}

.flora-scene-settings__runtime-settings-field-row {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    min-height: 18px;
}

.flora-scene-settings__runtime-settings-field-row .flora-editor-property-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.flora-scene-settings__runtime-settings-inline-button {
    width: 22px;
    min-width: 22px;
    height: 18px;
    min-height: 18px;
    margin-left: 4px;
    margin-right: 3px;
    padding-left: 3px;
    padding-right: 3px;
    flex-grow: 0;
    flex-shrink: 0;
    align-self: center;
}

.flora-scene-settings__runtime-settings-inline-button .flora-editor-icon-button__icon {
    width: 14px;
    min-width: 14px;
    height: 14px;
    min-height: 14px;
}

.flora-scene-settings__terrain-content--disabled .flora-editor-subgroup__content {
    opacity: 0.54;
}

.flora-scene-settings__terrain-content--disabled .flora-editor-subgroup__label {
    opacity: 0.86;
}

.flora-scene-settings__detail-streaming-cluster {
    flex-direction: column;
    align-self: stretch;
    margin-top: 3px;
    padding-top: 3px;
    border-top-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.12);
}

.flora-scene-settings__streamed-detail-budgets,
.flora-scene-settings__custom-detail-budgets,
.flora-scene-settings__immediate-detail-budgets {
    flex-direction: column;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    padding-left: 0;
    padding-right: 0;
}

.flora-scene-settings__streaming-footer {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    min-height: 24px;
    margin-top: 5px;
    margin-bottom: 1px;
    margin-right: 0;
    padding-left: 0;
    padding-right: 5px;
    padding-top: 1px;
    padding-bottom: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.14);
    border-bottom-color: rgba(0, 0, 0, 0.24);
    background-color: rgba(0, 0, 0, 0.12);
}

.flora-scene-settings__streaming-footer--full-width {
    margin-left: -32px;
    margin-right: -4px;
    padding-left: 32px;
}

.flora-scene-settings__streaming-footer-title {
    min-width: 126px;
    margin-right: 8px;
    padding-right: 0;
    opacity: 0.72;
    font-size: 11px;
    -unity-font-style: bold;
    flex-grow: 0;
    flex-shrink: 0;
}

.flora-scene-settings__streaming-budget-values {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.flora-scene-settings__streaming-budget-chip {
    min-height: 17px;
    margin-right: 4px;
    margin-top: 1px;
    margin-bottom: 1px;
    padding-left: 6px;
    padding-right: 6px;
    border-width: 1px;
    border-radius: 3px;
    border-color: rgba(128, 128, 128, 0.20);
    background-color: rgba(0, 0, 0, 0.20);
    opacity: 0.86;
    font-size: 11px;
    -unity-text-align: middle-center;
}

.flora-scene-settings__streaming-footer-note {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    opacity: 0.70;
    font-size: 11px;
    white-space: normal;
}

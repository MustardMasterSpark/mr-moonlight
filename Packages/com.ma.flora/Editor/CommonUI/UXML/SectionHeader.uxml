<UXML xmlns:ui="UnityEngine.UIElements">
  <ui:VisualElement name="section-header" class="flora-rendering-inspector-section__header">
    <ui:VisualElement name="icon" class="flora-rendering-inspector-section__icon" />
    <ui:VisualElement class="flora-rendering-inspector-section__label-container">
      <ui:Label name="label" class="flora-rendering-inspector-section__label" display-tooltip-when-elided="true" />
    </ui:VisualElement>
    <ui:Label name="summary" class="flora-rendering-inspector-section__summary" display-tooltip-when-elided="true" />
    <ui:Label name="count" class="flora-rendering-inspector-section__count" />
  </ui:VisualElement>
</UXML>

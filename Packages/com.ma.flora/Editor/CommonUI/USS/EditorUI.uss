.flora-editor-surface {
    flex-direction: column;
    flex-grow: 1;
    margin-left: -14px;
    margin-right: -4px;
    background-color: var(--unity-colors-window-background);
    color: var(--unity-colors-default-text);
}

.flora-editor-action-row {
    height: 28px;
    min-height: 28px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 2px;
    padding-right: 2px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
    background-color: var(--unity-colors-toolbar-background);
}

.flora-editor-action-row__left,
.flora-editor-action-row__right {
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

.flora-editor-action-row__left {
    justify-content: flex-start;
    flex-grow: 1;
    flex-shrink: 1;
}

.flora-editor-action-row__right {
    justify-content: flex-end;
    flex-grow: 0;
    flex-shrink: 0;
}

.flora-editor-action-row__right .flora-editor-icon-button {
    margin-left: 0;
    margin-right: 4px;
}

.flora-editor-action-row__right .flora-editor-icon-button:last-child {
    margin-right: 0;
}

.flora-editor-icon-button {
    width: 24px;
    min-width: 24px;
    height: 21px;
    min-height: 21px;
    margin-left: 0;
    margin-right: 4px;
    padding-left: 3px;
    padding-right: 3px;
    align-items: center;
    justify-content: center;
    background-color: #3f3f3f;
    border-color: #2a2a2a;
    border-width: 1px;
    border-radius: 3px;
}

.flora-editor-icon-button:hover {
    background-color: #4a4a4a;
    border-color: #5c5c5c;
}

.flora-editor-icon-button:active,
.flora-editor-icon-button:focus {
    background-color: #343434;
    border-color: #57AEFF;
}

.flora-editor-icon-button__icon {
    width: 15px;
    min-width: 15px;
    height: 15px;
    min-height: 15px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--unity-colors-default-text);
}

.flora-editor-icon-button--summary .flora-editor-icon-button__icon {
    background-image: var(--flora-summary-icon);
}

.flora-editor-icon-button--culling .flora-editor-icon-button__icon {
    background-image: var(--flora-culling-icon);
}

.flora-editor-icon-button--settings .flora-editor-icon-button__icon {
    background-image: var(--flora-settings-icon);
}

.flora-editor-icon-button--add .flora-editor-icon-button__icon {
    background-image: var(--flora-add-icon);
}

.flora-editor-icon-button--refresh .flora-editor-icon-button__icon {
    background-image: var(--flora-refresh-icon);
}

.flora-editor-icon-toggle-button--on {
    border-color: #57AEFF;
    background-color: rgba(87, 174, 255, 0.20);
}

.flora-editor-icon-toggle-button--on .flora-editor-icon-button__icon {
    -unity-background-image-tint-color: #9BD0FF;
}

.flora-editor-icon-toggle-button--off .flora-editor-icon-button__icon {
    opacity: 0.82;
}

.flora-editor-header-icon-button {
    margin-left: 4px;
    margin-right: 0;
}

.flora-editor-warning {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    min-height: 32px;
    padding-left: 9px;
    padding-right: 9px;
    padding-top: 6px;
    padding-bottom: 6px;
    border-left-width: 2px;
    border-bottom-width: 1px;
}

.flora-editor-warning--warning {
    border-left-color: #E5A94A;
    border-bottom-color: rgba(229, 169, 74, 0.20);
    background-color: rgba(229, 169, 74, 0.13);
}

.flora-editor-warning--error {
    border-left-color: #D85C5C;
    border-bottom-color: rgba(216, 92, 92, 0.22);
    background-color: rgba(216, 92, 92, 0.14);
}

.flora-editor-warning--info {
    border-left-color: #57AEFF;
    border-bottom-color: rgba(87, 174, 255, 0.18);
    background-color: rgba(87, 174, 255, 0.10);
}

.flora-editor-warning__icon {
    width: 16px;
    min-width: 16px;
    height: 16px;
    min-height: 16px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.flora-editor-warning__icon--warning,
.flora-editor-warning__icon--error {
    background-image: var(--flora-warning-icon);
}

.flora-editor-warning__icon--info {
    background-image: var(--flora-info-icon);
}

.flora-editor-warning__label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: 11px;
    white-space: normal;
}

.flora-editor-warning__action {
    min-width: 44px;
    height: 20px;
    min-height: 20px;
    margin-left: 8px;
    margin-right: 0;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 0;
    padding-bottom: 0;
    flex-grow: 0;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.flora-editor-tab-view {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
}

.flora-editor-tab-view__tab-header {
    flex-direction: row;
    flex-shrink: 0;
    flex-wrap: nowrap;
    height: 26px;
    min-height: 26px;
    padding-left: 0;
    padding-right: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.25);
    background-color: rgba(0, 0, 0, 0.14);
}

.flora-editor-tab-view__tab {
    flex-grow: 0;
    flex-shrink: 1;
    height: 26px;
    min-height: 26px;
    margin: 0;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 6px;
    padding-bottom: 4px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    opacity: 0.72;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.flora-editor-tab-view__tab:hover {
    opacity: 0.92;
}

.flora-editor-tab-view__tab--active {
    opacity: 1;
    border-bottom-color: #57AEFF;
}

.flora-editor-tab-view__tab-content {
    flex-grow: 1;
    flex-shrink: 1;
    background-color: var(--unity-colors-window-background);
}

.flora-editor-tab-page {
    flex-direction: column;
}

.flora-editor-section {
    flex-shrink: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding: 0;
    align-self: stretch;
}

.flora-editor-section > .unity-foldout__toggle,
.flora-editor-section .unity-foldout__toggle,
.flora-editor-section .unity-foldout__input,
.flora-editor-section .unity-toggle {
    margin-left: 0;
    padding-left: 0;
}

.flora-editor-section > .unity-foldout__content,
.flora-editor-section .unity-foldout__content {
    margin-left: 0;
    padding-left: 0;
}

.flora-editor-section__toggle {
    height: 24px;
    min-height: 24px;
    margin: 0;
    padding: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: rgba(128, 128, 128, 0.06);
    border-top-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.12);
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.18);
}

.flora-editor-section__toggle:hover {
    background-color: rgba(128, 128, 128, 0.14);
}

.flora-editor-section__label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
}

.flora-editor-section__label--with-icon {
    padding-left: 20px;
    background-size: 16px 16px;
    background-repeat: no-repeat;
    background-position-x: left;
    background-position-y: center;
    -unity-background-image-tint-color: var(--unity-colors-default-text);
}

.flora-editor-section__label--icon-property {
    background-image: var(--flora-property-icon);
}

.flora-editor-section__label--icon-grid {
    background-image: var(--flora-grid-icon);
}

.flora-editor-section__label--icon-culling-cpu {
    background-image: var(--flora-culling-cpu-icon);
}

.flora-editor-section__label--icon-culling-gpu {
    background-image: var(--flora-culling-gpu-icon);
}

.flora-editor-section__label--icon-buffer {
    background-image: var(--flora-buffer-icon);
}

.flora-editor-section__actions {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    flex-grow: 0;
    flex-shrink: 0;
    margin-left: 8px;
    margin-right: 6px;
}

.flora-editor-section__content {
    flex-direction: column;
    align-self: stretch;
    flex-grow: 1;
    margin-left: 0;
    margin-right: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 2px;
    padding-bottom: 3px;
}

.flora-editor-section__content--indented {
    padding-left: 22px;
    padding-right: 4px;
}

.flora-editor-section > .unity-foldout__content.flora-editor-section__content--indented,
.flora-editor-section .unity-foldout__content.flora-editor-section__content--indented {
    padding-left: 22px;
    padding-right: 4px;
}

.flora-editor-section--nested {
    margin-left: 0;
}

.flora-editor-subgroup {
    flex-direction: column;
    align-self: stretch;
    margin-top: 6px;
    margin-bottom: 2px;
}

.flora-editor-subgroup--first {
    margin-top: 0;
}

.flora-editor-subgroup__label {
    min-height: 20px;
    margin: 0;
    padding-left: 0;
    padding-right: 4px;
    border-top-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.16);
    background-color: rgba(128, 128, 128, 0.035);
    opacity: 0.86;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.flora-editor-subgroup__label--gutter {
    margin-left: -22px;
    margin-right: -4px;
    padding-left: 22px;
    padding-right: 4px;
    background-color: rgba(128, 128, 128, 0.025);
}

.flora-editor-subgroup--first .flora-editor-subgroup__label--gutter {
    border-top-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.flora-editor-subgroup__content {
    flex-direction: column;
    align-self: stretch;
    padding-left: 0;
    padding-right: 0;
}

.flora-editor-subgroup__content--indented {
    padding-left: 10px;
}

.flora-editor-subgroup__content .unity-base-field,
.flora-editor-subgroup__content .unity-base-field__label {
    margin-left: 0;
    padding-left: 0;
}

.flora-editor-property-field {
    align-self: stretch;
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 0;
    margin-right: 0;
    min-height: 18px;
}

.flora-editor-value-row {
    flex-direction: row;
    align-items: center;
    min-height: 20px;
    padding-left: 0;
    padding-right: 3px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.14);
}

.flora-editor-value-row__label {
    flex-grow: 0;
    flex-shrink: 1;
    width: 45%;
    min-width: 0;
    max-width: 260px;
    opacity: 0.72;
    font-size: 11px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.flora-editor-value-row__value {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: 11px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.flora-editor-info-row {
    flex-direction: row;
    align-items: flex-start;
    min-height: 24px;
    margin-top: 3px;
    margin-bottom: 3px;
    margin-left: 0;
    margin-right: 3px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 3px;
    padding-bottom: 3px;
    border-left-width: 2px;
    border-left-color: rgba(87, 174, 255, 0.45);
    background-color: rgba(87, 174, 255, 0.07);
    flex-wrap: nowrap;
}

.flora-editor-info-row__icon {
    width: 14px;
    min-width: 14px;
    height: 14px;
    min-height: 14px;
    margin-right: 5px;
    margin-top: 3px;
    opacity: 0.72;
    -unity-background-scale-mode: scale-to-fit;
    background-image: var(--flora-info-icon);
}

.flora-editor-info-row__label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    opacity: 0.72;
    font-size: 11px;
    white-space: normal;
    overflow: hidden;
}

.flora-editor-hint-row {
    flex-direction: row;
    align-items: center;
    min-height: 19px;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    padding-left: 0;
    padding-right: 3px;
    border-left-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.flora-editor-hint-row__label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    opacity: 0.70;
    font-size: 11px;
    white-space: normal;
    overflow: hidden;
}

.flora-editor-table {
    flex-direction: column;
}

.flora-editor-table__summary {
    min-height: 20px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 2px;
    padding-bottom: 2px;
    opacity: 0.72;
    font-size: 11px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.flora-editor-table__header,
.flora-editor-table__row {
    flex-direction: row;
    align-items: center;
    min-height: 22px;
    padding-left: 8px;
    padding-right: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.14);
}

.flora-editor-table__header {
    background-color: rgba(128, 128, 128, 0.08);
}

.flora-editor-table__cell {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    font-size: 11px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.flora-editor-table__cell--numeric {
    -unity-text-align: middle-right;
}

.flora-editor-table__cell--header {
    opacity: 0.72;
    -unity-font-style: bold;
}
